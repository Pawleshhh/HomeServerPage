{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "FridgeDbConnection": "Data Source=/app/Database/fridge.db",
    "AstronomyDbConnection": "Data Source=/app/Database/astronomy.db",
    "CaloriesDbConnection": "Data Source=/app/Database/calories.db",
    "ExerciseDbConnection": "Data Source=/app/Database/exercise.db"
  },
  "AllowedHosts": "*",
  "TabletDashboardRefresh": {
    "ActiveFrom": "07:00",
    "ActiveUntil": "23:00",
    "Widgets": {
      "FridgeIntervalMinutes": 60,
      "PublicTransportIntervalMinutes": 20,
      "WeatherIntervalMinutes": 60,
      "AstronomyIntervalMinutes": 1440
    }
  },
  "AppSettings": {
    "PrivateDataPath": "/app/data/private"
  }
}
