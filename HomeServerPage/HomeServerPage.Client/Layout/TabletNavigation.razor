@inject NavigationManager NavigationManager
@inject HomeServerPage.Data.IDateTimeService DateTimeService

<script type="module" src="@Assets["Layout/TabletNavigation.razor.js"]"></script>

<nav class="tablet-navigation" aria-label="Tablet navigation">
    <button class="tablet-navigation-link tablet-navigation-refresh" type="button" aria-label="Refresh page" title="Refresh page" @onclick="RefreshPage">
        <span class="tablet-navigation-icon" aria-hidden="true"><i class="bi bi-arrow-clockwise"></i></span>
    </button>
    <div class="tablet-navigation-theme">
        <ThemeToggle />
    </div>
    <div class="tablet-navigation-clock" aria-label="Current date and time" aria-live="polite" data-server-time="@currentDateTime?.ToString("yyyy-MM-ddTHH:mm:ss.fff")">
        @if (currentDateTime is DateTime now)
        {
            <span class="tablet-navigation-date">@now.ToString("d")</span>
            <span class="tablet-navigation-time">@now.ToString("HH:mm:ss")</span>
        }
        else
        {
            <span class="tablet-navigation-clock-status">Loading time…</span>
        }
    </div>
    <NavLink class="tablet-navigation-link" href="tablet-dashboard" Match="NavLinkMatch.All">
        <span class="tablet-navigation-icon" aria-hidden="true"><i class="bi bi-house-fill"></i></span>
    </NavLink>
    <NavLink class="tablet-navigation-link" href="tablet-dashboard/fridge">
        <span class="tablet-navigation-icon" aria-hidden="true"><i class="bi bi-snow2"></i></span>
    </NavLink>
    <NavLink class="tablet-navigation-link" href="tablet-dashboard/public-transport">
        <span class="tablet-navigation-icon" aria-hidden="true"><i class="bi bi-bus-front-fill"></i></span>
    </NavLink>
    <NavLink class="tablet-navigation-link" href="tablet-dashboard/weather">
        <span class="tablet-navigation-icon" aria-hidden="true"><i class="bi bi-cloud-sun-fill"></i></span>
    </NavLink>
    <NavLink class="tablet-navigation-link" href="tablet-dashboard/astronomy">
        <span class="tablet-navigation-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
    </NavLink>
</nav>

@code {
    private DateTime? currentDateTime;

    protected override async Task OnInitializedAsync()
    {
        await DateTimeService.SyncAsync();
        currentDateTime = DateTimeService.Now;
    }

    private void RefreshPage()
    {
        NavigationManager.Refresh(forceReload: true);
    }
}