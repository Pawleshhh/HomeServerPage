@implements IDisposable
@inject NavigationManager NavigationManager

<header class="app-header">
    <div class="app-header-bar">
        <a class="app-brand" href="" @onclick="CloseMenu">
            <span class="app-brand-mark" aria-hidden="true">HB</span>
            <span class="app-brand-copy">
                <span class="app-brand-name">Home Base</span>
                <span class="app-brand-subtitle">Personal dashboard</span>
            </span>
        </a>

        <div class="app-header-actions">
            <ThemeToggle />
            <button class="nav-toggle"
                    type="button"
                    aria-controls="primary-navigation"
                    aria-expanded="@isMenuOpen"
                    aria-label="@(isMenuOpen ? "Close navigation menu" : "Open navigation menu")"
                    @onclick="ToggleMenu">
                <span class="nav-toggle-icon" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                <span class="nav-toggle-label">Menu</span>
            </button>
        </div>
    </div>

    <div id="primary-navigation" class="nav-drawer @(isMenuOpen ? "is-open" : null)">
        <nav class="primary-navigation" aria-label="Primary navigation">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <span class="nav-icon" aria-hidden="true"><i class="bi bi-house-fill"></i></span>
            </NavLink>

            <NavLink class="nav-link" href="fridge" @onclick="CloseMenu">
                <span class="nav-icon" aria-hidden="true"><i class="bi bi-snow2"></i></span>
            </NavLink>

            <NavLink class="nav-link" href="public-transport" @onclick="CloseMenu">
                <span class="nav-icon" aria-hidden="true"><i class="bi bi-bus-front-fill"></i></span>
            </NavLink>

            <NavLink class="nav-link" href="weather" @onclick="CloseMenu">
                <span class="nav-icon" aria-hidden="true"><i class="bi bi-cloud-sun-fill"></i></span>
            </NavLink>

            <NavLink class="nav-link" href="astronomy" @onclick="CloseMenu">
                <span class="nav-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
            </NavLink>

            <NavLink class="nav-link" href="tablet-dashboard" aria-label="Tablet dashboard" @onclick="CloseMenu">
                <span class="nav-icon" aria-hidden="true"><i class="bi bi-tablet"></i></span>
            </NavLink>
        </nav>
    </div>

    @if (isMenuOpen)
    {
        <button class="nav-backdrop" type="button" aria-label="Close navigation menu" @onclick="CloseMenu"></button>
    }
</header>

@code {
    private bool isMenuOpen;
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void CloseMenu() => isMenuOpen = false;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!isMenuOpen)
        {
            return;
        }

        isMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
