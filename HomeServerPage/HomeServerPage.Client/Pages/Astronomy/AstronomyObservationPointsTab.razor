@using AstroCalc.Core
@using HomeServerPage.Data.Astronomy

@implements IDisposable

@inject IAstronomyService AstronomyService
@inject IObservationPointService ObservationPointService

<div id="observation-points-panel"
     class="pt-4 observation-points-tab"
     role="tabpanel"
     aria-labelledby="observation-points-tab">
    <div class="row g-4">
        <div class="col-12 col-xl-5">
            <section class="astronomy-panel" aria-labelledby="observation-point-editor-heading">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h2 id="observation-point-editor-heading" class="h4 mb-1">Observation point</h2>
                        <p class="text-body-secondary mb-0">Save a location and describe its local horizon.</p>
                    </div>

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="StartNewPoint"
                            disabled="@isSaving || isDeleting">
                        New
                    </button>
                </div>

                @if (editorError is not null)
                {
                    <div class="alert alert-danger" role="alert">@editorError</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="observation-point-editor-select">Saved point</label>
                    <select id="observation-point-editor-select"
                            class="form-select"
                            @bind="editorPointId"
                            @bind:after="OnEditorPointSelected">
                        <option value="">New observation point</option>
                        @foreach (var observationPoint in ObservationPoints)
                        {
                            <option value="@observationPoint.Id">@observationPoint.Name</option>
                        }
                    </select>
                </div>

                <EditForm Model="editPoint" OnValidSubmit="SaveObservationPointAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="mb-3">
                        <label class="form-label" for="observation-point-name">Name</label>
                        <InputText id="observation-point-name"
                                   class="form-control"
                                   @bind-Value="editPoint.Name" />
                        <ValidationMessage For="@(() => editPoint.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Coordinates</label>
                        <GeoLocationInput Value="editLocation"
                                          ValueChanged="OnEditLocationChanged"
                                          ShowElevation="false" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="observation-point-elevation">Elevation (m) <span class="text-body-secondary">(optional)</span></label>
                        <InputNumber id="observation-point-elevation"
                                     class="form-control"
                                     @bind-Value="editPoint.ElevationMeters" />
                    </div>

                    <fieldset class="mb-3">
                        <legend class="h6">Minimum visible altitude</legend>
                        <p class="form-text mt-0">Set the altitude above the horizon at which the sky becomes visible in each direction.</p>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-north">N (°)</label>
                                <InputNumber id="horizon-north" class="form-control" @bind-Value="editPoint.HorizonNorth" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-north-east">NE (°)</label>
                                <InputNumber id="horizon-north-east" class="form-control" @bind-Value="editPoint.HorizonNorthEast" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-east">E (°)</label>
                                <InputNumber id="horizon-east" class="form-control" @bind-Value="editPoint.HorizonEast" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-south-east">SE (°)</label>
                                <InputNumber id="horizon-south-east" class="form-control" @bind-Value="editPoint.HorizonSouthEast" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-south">S (°)</label>
                                <InputNumber id="horizon-south" class="form-control" @bind-Value="editPoint.HorizonSouth" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-south-west">SW (°)</label>
                                <InputNumber id="horizon-south-west" class="form-control" @bind-Value="editPoint.HorizonSouthWest" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-west">W (°)</label>
                                <InputNumber id="horizon-west" class="form-control" @bind-Value="editPoint.HorizonWest" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="horizon-north-west">NW (°)</label>
                                <InputNumber id="horizon-north-west" class="form-control" @bind-Value="editPoint.HorizonNorthWest" />
                            </div>
                        </div>
                    </fieldset>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @(isSaving ? "Saving..." : "Save point")
                        </button>
                        <button type="button"
                                class="btn btn-outline-danger"
                                @onclick="DeleteObservationPointAsync"
                                disabled="@(editPoint.Id == 0 || isSaving || isDeleting)">
                            @(isDeleting ? "Deleting..." : "Delete")
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>

        <div class="col-12 col-xl-7">
            <section class="astronomy-panel" aria-labelledby="visibility-filters-heading">
                <div class="mb-3">
                    <h2 id="visibility-filters-heading" class="h4 mb-1">Visible objects</h2>
                    <p class="text-body-secondary mb-0">Find objects that clear the saved horizon during the selected range.</p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="visibility-from">From (local time)</label>
                        <InputDate id="visibility-from"
                                   class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="rangeStartLocal"
                                   @bind-Value:after="OnRangeChanged" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="visibility-to">To (local time)</label>
                        <InputDate id="visibility-to"
                                   class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="rangeEndLocal"
                                   @bind-Value:after="OnRangeChanged" />
                    </div>
                </div>

                <fieldset class="filter-group mb-3">
                    <legend class="h6">Directions</legend>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var direction in Directions)
                        {
                            <label class="form-check form-check-inline direction-filter">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@IsDirectionSelected(direction)"
                                       @onchange="eventArgs => SetDirectionSelection(direction, eventArgs)" />
                                <span class="form-check-label">@FormatDirection(direction)</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="filter-group mb-4">
                    <legend class="h6">Object types</legend>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var objectType in ObjectTypes)
                        {
                            <label class="form-check form-check-inline object-type-filter">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@IsObjectTypeSelected(objectType)"
                                       @onchange="eventArgs => SetObjectTypeSelection(objectType, eventArgs)" />
                                <span class="form-check-label">@FormatObjectType(objectType)</span>
                            </label>
                        }
                    </div>
                </fieldset>

                @if (calculationError is not null)
                {
                    <div class="alert alert-danger" role="alert">@calculationError</div>
                }
                else if (isCalculating)
                {
                    <p class="text-body-secondary" role="status">Calculating visible objects...</p>
                }
                else if (FilteredVisibleObjects.Count == 0)
                {
                    <p class="text-body-secondary mb-0">No objects match the selected filters and time range.</p>
                }
                else
                {
                    <div class="visibility-results">
                        @foreach (var observation in FilteredVisibleObjects)
                        {
                            <article class="visibility-object-card">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <div>
                                        <h3 class="h5 mb-1">@observation.Name</h3>
                                        <span class="text-body-secondary small">@FormatObjectType(observation.ObjectType)</span>
                                    </div>
                                    <span class="visibility-total">@FormatDuration(observation.TotalVisibleDuration)</span>
                                </div>

                                <div class="visibility-windows">
                                    @foreach (var window in observation.Windows)
                                    {
                                        <div class="visibility-window">
                                            <span class="visibility-direction">@FormatDirection(window.Direction)</span>
                                            <span>@FormatLocalTime(window.StartUtc) – @FormatLocalTime(window.EndUtc)</span>
                                            <span class="text-body-secondary">@FormatDuration(window.Duration)</span>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>
