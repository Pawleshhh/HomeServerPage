@using HomeServerPage.Client.Data.Astronomy.Telescopes

@inject ITelescopeService TelescopeService

<div class="pt-4" role="tabpanel" aria-labelledby="tools-tab">
    <section class="astronomy-panel setup-panel" aria-labelledby="setup-heading">
        <div class="mb-4">
            <h2 id="setup-heading" class="h4 mb-1">Observation setup</h2>
            <p class="text-body-secondary mb-0">Choose the equipment for your observing session.</p>
        </div>

        @if (setupLoadError is not null)
        {
            <div class="alert alert-danger mb-0" role="alert">
                @setupLoadError
            </div>
        }
        else
        {
            <EditForm Model="this">
                <div class="row g-3 setup-form">
                    <div class="col-12 col-xl-3 setup-field">
                        <label class="form-label" for="setup-telescope">Telescope</label>
                        <select id="setup-telescope" class="form-select" @bind="selectedTelescopeId" @bind:after="RecalculateResults" required>
                            <option value="">Select a telescope</option>
                            @foreach (var telescope in telescopes)
                            {
                                <option value="@telescope.Id">@telescope.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-xl-3 setup-field">
                        <label class="form-label" for="setup-lens">Lens <span class="text-body-secondary">(optional)</span></label>
                        <select id="setup-lens" class="form-select" @bind="selectedLensId" @bind:after="RecalculateResults">
                            <option value="">No lens</option>
                            @foreach (var lens in lenses)
                            {
                                <option value="@lens.Id">@lens.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-xl-3 setup-field">
                        <label class="form-label" for="setup-eyepiece">Eyepiece</label>
                        <select id="setup-eyepiece" class="form-select" @bind="selectedEyepieceId" @bind:after="RecalculateResults">
                            <option value="">Select an eyepiece</option>
                            @foreach (var eyepiece in eyepieces)
                            {
                                <option value="@eyepiece.Id">@eyepiece.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-xl-3 setup-field">
                        <label class="form-label" for="setup-sensor">Sensor</label>
                        <select id="setup-sensor" class="form-select" @bind="selectedSensorId" @bind:after="RecalculateResults">
                            <option value="">Select a sensor</option>
                            @foreach (var sensor in sensors)
                            {
                                <option value="@sensor.Id">@sensor.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </EditForm>
        }
    </section>

    <section class="astronomy-panel results-panel mt-4" aria-labelledby="dso-heading">
        <div class="mb-4">
            <h2 id="dso-heading" class="h4 mb-1">Observable deep sky objects</h2>
            <p class="text-body-secondary mb-0">Objects that fit within the field of view of your current setup.</p>
        </div>

        <div class="result-view-selector">
            <label class="form-label" for="result-view">Show</label>
            <select id="result-view" class="form-select" @bind="resultViewMode">
                <option value="@ResultViewMode.Both">Both lists</option>
                <option value="@ResultViewMode.Visual">Visual observation</option>
                <option value="@ResultViewMode.Photography">Astrophotography</option>
            </select>
        </div>

        @if (selectedTelescope is null)
        {
            <p class="text-body-secondary mb-0">Select a telescope to see which deep sky objects fit your setup.</p>
        }
        else
        {
            <div class="row g-4">
                @if (resultViewMode is ResultViewMode.Both or ResultViewMode.Visual)
                {
                <div class="@(resultViewMode == ResultViewMode.Visual ? "col-12" : "col-12 col-xl-6")">
                    <div class="result-column-heading">
                        <h3 class="h5 mb-0">Visual observation</h3>
                        @if (selectedEyepiece is not null)
                        {
                            <span class="result-count">@(visualObjects.Count + visualPartialObjects.Count) objects</span>
                        }
                    </div>
                    @if (selectedEyepiece is null)
                    {
                        <p class="text-body-secondary">Select an eyepiece to list objects visible through the eyepiece.</p>
                    }
                    else
                    {
                        <p class="text-body-secondary">True field of view: @visualFieldOfViewArcmin?.ToString("0.##") arcmin</p>
                        @if (visualObjects.Count == 0 && visualPartialObjects.Count == 0)
                        {
                            <p class="text-body-secondary">No deep sky objects fit within this field of view.</p>
                        }
                        else
                        {
                            <ul class="object-grid" aria-label="Objects fully visible through the eyepiece">
                                @foreach (var dso in visualObjects)
                                {
                                    <li class="object-card">
                                        <span class="object-name">@dso.Symbol @dso.Catalog</span>
                                        <span class="object-size">@dso.Width x @dso.Height <small>arcmin</small></span>
                                    </li>
                                }
                            </ul>
                            @if (visualPartialObjects.Count > 0)
                            {
                                <div class="partial-results">
                                    <p class="partial-results-heading">At least 90% of the object fits</p>
                                    <ul class="object-grid" aria-label="Objects mostly visible through the eyepiece">
                                        @foreach (var dso in visualPartialObjects)
                                        {
                                            <li class="object-card" style="@GetVisualPartialObjectStyle(dso)">
                                                <span class="object-name">@dso.Symbol @dso.Catalog</span>
                                                <span class="object-size">@dso.Width x @dso.Height <small>arcmin</small></span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    }
                </div>

                }

                @if (resultViewMode is ResultViewMode.Both or ResultViewMode.Photography)
                {
                <div class="@(resultViewMode == ResultViewMode.Photography ? "col-12" : "col-12 col-xl-6")">
                    <div class="result-column-heading">
                        <h3 class="h5 mb-0">Astrophotography</h3>
                        @if (selectedSensor is not null)
                        {
                            <span class="result-count">@(photoObjects.Count + photoPartialObjects.Count) objects</span>
                        }
                    </div>
                    @if (selectedSensor is null)
                    {
                        <p class="text-body-secondary">Select a sensor to list objects that fit within the camera frame.</p>
                    }
                    else
                    {
                        <p class="text-body-secondary">
                            Field of view: @photoFieldOfViewWidthArcmin?.ToString("0.##") x @photoFieldOfViewHeightArcmin?.ToString("0.##") arcmin
                        </p>
                        @if (photoObjects.Count == 0 && photoPartialObjects.Count == 0)
                        {
                            <p class="text-body-secondary">No deep sky objects fit within this field of view.</p>
                        }
                        else
                        {
                            <ul class="object-grid" aria-label="Objects fully visible in the camera frame">
                                @foreach (var dso in photoObjects)
                                {
                                    <li class="object-card">
                                        <span class="object-name">@dso.Symbol @dso.Catalog</span>
                                        <span class="object-size">@dso.Width x @dso.Height <small>arcmin</small></span>
                                    </li>
                                }
                            </ul>
                            @if (photoPartialObjects.Count > 0)
                            {
                                <div class="partial-results">
                                    <p class="partial-results-heading">At least 90% of the object fits</p>
                                    <ul class="object-grid" aria-label="Objects mostly visible in the camera frame">
                                        @foreach (var dso in photoPartialObjects)
                                        {
                                            <li class="object-card" style="@GetPhotoPartialObjectStyle(dso)">
                                                <span class="object-name">@dso.Symbol @dso.Catalog</span>
                                                <span class="object-size">@dso.Width x @dso.Height <small>arcmin</small></span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    }
                </div>
                }
            </div>
        }
    </section>
</div>
