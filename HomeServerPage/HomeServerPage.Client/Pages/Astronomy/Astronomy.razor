@page "/astronomy"
@page "/tablet-dashboard/astronomy"

@using AstroCalc.Core
@using HomeServerPage.Data.Astronomy

@inject IObservationPointService ObservationPointService

<PageTitle>Astronomy</PageTitle>

<div class="container-fluid astronomy-page">
    <PageHeader Title="Astronomy"
                Description="Tools and conditions for observing the sky."
                Accent="astronomy" />

    <section class="observer-settings astronomy-settings-panel mb-4" aria-labelledby="observer-settings-heading">
        <h2 id="observer-settings-heading" class="visually-hidden">Observation settings</h2>
        <div class="row g-3 astronomy-settings-grid">
            <div class="col-12 col-lg-8">
                <label class="form-label" for="observation-point-select">Observation point</label>
                @if (isLoadingObservationPoints)
                {
                    <p class="form-text mt-0 mb-2" role="status">Loading saved observation points...</p>
                }
                else
                {
                    <select id="observation-point-select"
                            class="form-select mb-2"
                            @bind="selectedObservationPointId"
                            @bind:after="OnObservationPointSelected">
                        <option value="">Custom location</option>
                        @foreach (var observationPoint in observationPoints)
                        {
                            <option value="@observationPoint.Id">@observationPoint.Name</option>
                        }
                    </select>
                }

                @if (observationPointLoadError is not null)
                {
                    <p class="form-text text-danger mt-0 mb-2">@observationPointLoadError</p>
                }

                <GeoLocationInput Value="location" ValueChanged="OnLocationChanged" />
            </div>

            <div class="col-12 col-lg-4">
                <EditForm Model="this">
                    <label class="form-label" for="observation-datetime">Observation date and time</label>
                    <InputDate id="observation-datetime"
                               @bind-Value="selectedLocalDateTime"
                               @bind-Value:after="OnSelectedDateTimeChanged"
                               Type="InputDateType.DateTimeLocal"
                               class="form-control" />
                </EditForm>
            </div>
        </div>
    </section>

    <ul class="nav nav-tabs astronomy-tabs" role="tablist" aria-label="Astronomy sections">
        @foreach (var tab in astronomyTabs)
        {
            <li class="nav-item" role="presentation">
                <button id="@tab.Key-tab"
                        class='nav-link astronomy-tab-button @(IsActive(tab) ? "active" : null)'
                        type="button"
                        role="tab"
                        aria-controls="@tab.PanelId"
                        aria-selected="@IsActive(tab)"
                        @onclick="() => ShowTab(tab.Key)">
                    @tab.Label
                </button>
            </li>
        }
    </ul>

    <div class="astronomy-tab-content">
        <DynamicComponent @key="CurrentTab.Key"
                          Type="CurrentTab.ComponentType"
                          Parameters="CurrentTabParameters" />
    </div>
</div>
