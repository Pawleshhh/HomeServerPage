@page "/astronomy"

@using AstroCalc.Core
@using AstroCalc.Observation
@using AstroCalc.SolarSystem
@using HomeServerPage.Data.Astronomy

@inject IAstronomyService AstronomyService

<PageTitle>Astronomy</PageTitle>

<div class="container-fluid astronomy-page">
    <div class="mb-4">
        <h1 class="h3 mb-1">Astronomy</h1>
        <p class="text-body-secondary mb-0">
            Tools and conditions for observing the sky.
        </p>
    </div>

    <div class="astronomy-content">
        <div class="astronomy-widget-container">
            <div class="astronomy-widget-scaler">
                <iframe title="Meteoblue astronomy seeing forecast for Szczecin"
                        src="https://www.meteoblue.com/pl/pogoda/widget/seeing/szczecin_polska_3083831?geoloc=fixed&amp;noground=0&amp;user_key=b67614fda7c8833a&amp;embed_key=4a81ac28e7ff4564&amp;sig=7fd707cae798efea3c4df86249173da2068cf9d04a6c5a4bde2f86115ca8c2"
                        frameborder="0"
                        scrolling="no"
                        allowtransparency="true"
                        sandbox="allow-same-origin allow-scripts allow-popups allow-popups-to-escape-sandbox"></iframe>
            </div>

            <div>
                <a href="https://www.meteoblue.com/pl/pogoda/tydzie%C5%84/index"
                   target="_blank"
                   rel="noopener">
                    meteoblue
                </a>
            </div>
        </div>

        <section class="planet-list" aria-labelledby="planet-list-heading">
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <h2 id="planet-list-heading" class="h4 mb-0">Planets</h2>

                @if (observationTime is not null)
                {
                    <small class="text-body-secondary">
                        @observationTime.Value.ToString("g")
                    </small>
                }
            </div>

            <div class="observer-settings mb-3">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg-8">
                        <GeoLocationInput Value="location" ValueChanged="OnLocationChanged" />
                    </div>

                    <div class="col-12 col-lg-4">
                        <EditForm Model="this">
                            <label class="form-label" for="observation-datetime">Observation date and time</label>
                            <InputDate id="observation-datetime"
                                       @bind-Value="selectedLocalDateTime"
                                       @bind-Value:after="OnSelectedDateTimeChanged"
                                       Type="InputDateType.DateTimeLocal"
                                       class="form-control form-control-sm" />
                        </EditForm>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <p class="text-body-secondary">Loading planetary observations…</p>
            }
            else if (loadError is not null)
            {
                <div class="alert alert-danger" role="alert">
                    @loadError
                </div>
            }
            else
            {
                <div class="planet-items">
                    @foreach (var observation in observations)
                    {
                        <article class="planet-item">
                            <img class="planet-icon"
                                 src="@GetPlanetImageUrl(observation.Planet)"
                                 alt="@($"{observation.Planet}")" />

                            <div class="planet-details">
                                <h3 class="h5 mb-2">@observation.Planet</h3>

                                @foreach (var value in GetResultValues(observation.Result))
                                {
                                    <div class="planet-result">
                                        <span class="text-body-secondary">@value.Label</span>
                                        <span>@value.Value</span>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private const double Latitude = 53.42890170607857;
    private const double Longitude = 14.552826366632289;

    private static readonly TimeZoneInfo LocalTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Warsaw");

    private GeographicCoordinate location =
        new(Angle.FromDegrees(Latitude), Angle.FromDegrees(Longitude), 0);

    private DateTime selectedLocalDateTime;

    private IReadOnlyList<PlanetObservation> observations = [];
    private DateTimeOffset? observationTime;
    private DateTime requestDateUtc;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        var nowInPoland = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, LocalTimeZone);
        selectedLocalDateTime = nowInPoland.DateTime;

        await LoadObservationsAsync();
    }

    private async Task OnLocationChanged(GeographicCoordinate newLocation)
    {
        location = newLocation;
        await LoadObservationsAsync();
    }

    private async Task OnSelectedDateTimeChanged()
    {
        await LoadObservationsAsync();
    }

    private async Task LoadObservationsAsync()
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        requestDateUtc = TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(selectedLocalDateTime, DateTimeKind.Unspecified),
            LocalTimeZone);
        observationTime = TimeZoneInfo.ConvertTime(
            new DateTimeOffset(requestDateUtc, TimeSpan.Zero),
            LocalTimeZone);

        try
        {
            var planets = Enum.GetValues<Planet>();

            var results = await Task.WhenAll(
                planets.Select(async planet =>
                    new PlanetObservation(
                        planet,
                        await AstronomyService.GetPlanetRiseAndSetTime(
                            requestDateUtc,
                            location,
                            planet))));

            observations = results;
        }
        catch (Exception exception)
        {
            loadError = $"Unable to load planetary observations: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetPlanetImageUrl(Planet planet) =>
        $"images/astronomy/planets/{planet.ToString().ToLowerInvariant()}.png";

    private IEnumerable<(string Label, string Value)> GetResultValues(
        RiseTransitSetResult result)
    {
        yield return ("Rise", FormatUtHours(result.RiseUT));
        yield return ("Transit", FormatUtHours(result.TransitUT));
        yield return ("Set", FormatUtHours(result.SetUT));

        if (result.RisesAndSets)
        {
            yield return ("Above horizon", FormatDuration(result.HoursAboveHorizon));
        }
    }

    private string FormatUtHours(double utHours)
    {
        if (double.IsNaN(utHours))
        {
            return "—";
        }

        var utcDateTime = DateTime.SpecifyKind(requestDateUtc.Date.AddHours(utHours), DateTimeKind.Utc);
        var localDateTime = TimeZoneInfo.ConvertTimeFromUtc(utcDateTime, LocalTimeZone);
        return localDateTime.ToString("HH:mm");
    }

    private static string FormatDuration(double hours)
    {
        if (double.IsNaN(hours))
        {
            return "—";
        }

        var timeSpan = TimeSpan.FromHours(hours);
        return $"{(int)timeSpan.TotalHours}h {timeSpan.Minutes:D2}m";
    }

    private sealed record PlanetObservation(
        Planet Planet,
        RiseTransitSetResult Result);
}