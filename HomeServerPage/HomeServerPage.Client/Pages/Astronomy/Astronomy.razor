@page "/astronomy"

@using AstroCalc.Core
@using HomeServerPage.Data.Astronomy
@using HomeServerPage.Client.Data.Astronomy.Telescopes

@inject IAstronomyService AstronomyService
@inject ITelescopeService TelescopeService

<PageTitle>Astronomy</PageTitle>

<div class="container-fluid astronomy-page">
    <div class="mb-4">
        <h1 class="h3 mb-1">Astronomy</h1>
        <p class="text-body-secondary mb-0">
            Tools and conditions for observing the sky.
        </p>
    </div>

    <section class="observer-settings mb-4" aria-labelledby="observer-settings-heading">
        <h2 id="observer-settings-heading" class="visually-hidden">Observation settings</h2>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-8">
                <GeoLocationInput Value="location" ValueChanged="OnLocationChanged" />
            </div>

            <div class="col-12 col-lg-4">
                <EditForm Model="this">
                    <label class="form-label" for="observation-datetime">Observation date and time</label>
                    <InputDate id="observation-datetime"
                               @bind-Value="selectedLocalDateTime"
                               @bind-Value:after="OnSelectedDateTimeChanged"
                               Type="InputDateType.DateTimeLocal"
                               class="form-control form-control-sm" />
                </EditForm>
            </div>
        </div>
    </section>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button id="observations-tab"
                    class='nav-link @(activeTab == "observations" ? "active" : null)'
                    type="button"
                    role="tab"
                    aria-controls="observations-panel"
                    aria-selected='@(activeTab == "observations")'
                    @onclick="ShowObservations">
                Observations
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button id="tools-tab"
                    class='nav-link @(activeTab == "tools" ? "active" : null)'
                    type="button"
                    role="tab"
                    aria-controls="tools-panel"
                    aria-selected='@(activeTab == "tools")'
                    @onclick="ShowTools">
                Astronomy tools
            </button>
        </li>
    </ul>

    @if (activeTab == "observations")
    {
        <div id="observations-panel" class="pt-4" role="tabpanel" aria-labelledby="observations-tab">
            <div class="astronomy-content">
                <section class="astronomy-panel celestial-body-list" aria-labelledby="celestial-body-list-heading">
                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <h2 id="celestial-body-list-heading" class="h4 mb-0">Celestial bodies</h2>

                        @if (observationTime is not null)
                        {
                            <small class="text-body-secondary">
                                @observationTime.Value.ToString("g")
                            </small>
                        }
                    </div>

                    @if (isLoading)
                    {
                        <p class="text-body-secondary">Loading celestial observations…</p>
                    }
                    else if (loadError is not null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @loadError
                        </div>
                    }
                    else
                    {
                        <PlanetObservationList Observations="solarSystemObservations" RequestDateUtc="requestDateUtc" />
                    }
                </section>

                <section class="astronomy-panel astronomy-future-panel" aria-labelledby="astronomy-future-heading">
                    <h2 id="astronomy-future-heading" class="h5">Visible Messier objects</h2>

                    @if (isLoading)
                    {
                        <p class="text-body-secondary mb-0" role="status">Loading Messier observations…</p>
                    }
                    else if (loadError is null && messierObservations.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">No Messier objects rise and set at this location.</p>
                    }
                    else if (loadError is null)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                            <label class="small text-body-secondary" for="messier-sort">Sort by</label>
                            <select id="messier-sort" class="form-select form-select-sm w-auto" @bind="messierSort">
                                <option value="@MessierSort.Name">Name</option>
                                <option value="@MessierSort.RiseTime">Rise time</option>
                                <option value="@MessierSort.SetTime">Set time</option>
                            </select>
                        </div>

                        <div class="messier-observation-list">
                            <div class="messier-observation-items">
                                @foreach (var messier in SortedMessierObservations)
                                {
                                    <article class="astronomy-object-card messier-observation-item">
                                        <span class="messier-observation-name">@messier.Name</span>
                                        <div class="messier-observation-times">
                                            <span>Rise @messier.TransitResult.RiseUT.FormatUtHours(requestDateUtc, AstronomyDefaults.LocalTimeZone)</span>
                                            <span>Set @messier.TransitResult.SetUT.FormatUtHours(requestDateUtc, AstronomyDefaults.LocalTimeZone)</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </section>
            </div>
        </div>
    }
    else
    {
        <div id="tools-panel" class="pt-4" role="tabpanel" aria-labelledby="tools-tab">
            <section class="astronomy-panel setup-panel" aria-labelledby="setup-heading">
                <div class="mb-4">
                    <h2 id="setup-heading" class="h4 mb-1">Observation setup</h2>
                    <p class="text-body-secondary mb-0">Choose the equipment for your observing session.</p>
                </div>

                @if (setupLoadError is not null)
                {
                    <div class="alert alert-danger mb-0" role="alert">
                        @setupLoadError
                    </div>
                }
                else
                {
                    <EditForm Model="this">
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <label class="form-label" for="setup-telescope">Telescope</label>
                                <select id="setup-telescope" class="form-select" @bind="selectedTelescopeId" required>
                                    <option value="">Select a telescope</option>
                                    @foreach (var telescope in telescopes)
                                    {
                                        <option value="@telescope.Id">@telescope.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-lg-6">
                                <label class="form-label" for="setup-lens">Lens <span class="text-body-secondary">(optional)</span></label>
                                <select id="setup-lens" class="form-select" @bind="selectedLensId">
                                    <option value="">No lens</option>
                                    @foreach (var lens in lenses)
                                    {
                                        <option value="@lens.Id">@lens.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <fieldset>
                                    <legend class="col-form-label pt-0">Output device</legend>
                                    <div class="d-flex flex-wrap gap-3">
                                        <div class="form-check">
                                            <input id="setup-eyepiece-type"
                                                   class="form-check-input"
                                                   type="radio"
                                                   name="setup-device-type"
                                                   checked="@(selectedDeviceType == SetupDeviceType.Eyepiece)"
                                                   @onchange="@(() => selectedDeviceType = SetupDeviceType.Eyepiece)" />
                                            <label class="form-check-label" for="setup-eyepiece-type">Eyepiece</label>
                                        </div>
                                        <div class="form-check">
                                            <input id="setup-sensor-type"
                                                   class="form-check-input"
                                                   type="radio"
                                                   name="setup-device-type"
                                                   checked="@(selectedDeviceType == SetupDeviceType.Sensor)"
                                                   @onchange="@(() => selectedDeviceType = SetupDeviceType.Sensor)" />
                                            <label class="form-check-label" for="setup-sensor-type">Sensor</label>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="col-12 col-lg-6">
                                @if (selectedDeviceType == SetupDeviceType.Eyepiece)
                                {
                                    <label class="form-label" for="setup-eyepiece">Eyepiece</label>
                                    <select id="setup-eyepiece" class="form-select" @bind="selectedEyepieceId" required>
                                        <option value="">Select an eyepiece</option>
                                        @foreach (var eyepiece in eyepieces)
                                        {
                                            <option value="@eyepiece.Id">@eyepiece.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <label class="form-label" for="setup-sensor">Sensor</label>
                                    <select id="setup-sensor" class="form-select" @bind="selectedSensorId" required>
                                        <option value="">Select a sensor</option>
                                        @foreach (var sensor in sensors)
                                        {
                                            <option value="@sensor.Id">@sensor.Name</option>
                                        }
                                    </select>
                                }
                            </div>
                        </div>
                    </EditForm>
                }
            </section>
        </div>
    }
</div>

@code {
    private GeographicCoordinate location =
        AstronomyDefaults.Location;

    private DateTime selectedLocalDateTime;

    private IReadOnlyList<AstronomyObservation> solarSystemObservations = [];
    private IReadOnlyList<AstronomyObservation> messierObservations = [];
    private DateTimeOffset? observationTime;
    private DateTime requestDateUtc;
    private bool isLoading = true;
    private string? loadError;
    private MessierSort messierSort = MessierSort.Name;
    private string activeTab = "observations";
    private IReadOnlyList<TelescopeItem> telescopes = [];
    private IReadOnlyList<TelescopeEyepiece> eyepieces = [];
    private IReadOnlyList<TelescopeLens> lenses = [];
    private IReadOnlyList<SensorItem> sensors = [];
    private string? setupLoadError;
    private int? selectedTelescopeId;
    private int? selectedLensId;
    private int? selectedEyepieceId;
    private int? selectedSensorId;
    private SetupDeviceType selectedDeviceType = SetupDeviceType.Eyepiece;

    private IEnumerable<AstronomyObservation> SortedMessierObservations => messierSort switch
    {
        MessierSort.RiseTime => messierObservations.OrderBy(observation => observation.TransitResult.RiseUT),
        MessierSort.SetTime => messierObservations.OrderBy(observation => observation.TransitResult.SetUT),
        _ => messierObservations.OrderBy(observation => observation.Name)
    };

    private void ShowObservations() => activeTab = "observations";

    private void ShowTools() => activeTab = "tools";

    protected override async Task OnInitializedAsync()
    {
        var nowInPoland = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, AstronomyDefaults.LocalTimeZone);
        selectedLocalDateTime = nowInPoland.DateTime;

        await LoadObservationsAsync();
        await LoadSetupItemsAsync();
    }

    private async Task OnLocationChanged(GeographicCoordinate newLocation)
    {
        location = newLocation;
        await LoadObservationsAsync();
    }

    private async Task OnSelectedDateTimeChanged()
    {
        await LoadObservationsAsync();
    }

    private async Task LoadObservationsAsync()
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        requestDateUtc = TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(selectedLocalDateTime, DateTimeKind.Unspecified),
            AstronomyDefaults.LocalTimeZone);
        observationTime = TimeZoneInfo.ConvertTime(
            new DateTimeOffset(requestDateUtc, TimeSpan.Zero),
            AstronomyDefaults.LocalTimeZone);

        try
        {
            solarSystemObservations = await AstronomyObservationLoader.LoadSolarSystemAsync(
                AstronomyService,
                requestDateUtc,
                location);

            messierObservations = await AstronomyObservationLoader.LoadMessierCatalogAsync(
                AstronomyService,
                requestDateUtc,
                location);
        }
        catch (Exception exception)
        {
            loadError = $"Unable to load celestial observations: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSetupItemsAsync()
    {
        setupLoadError = null;

        try
        {
            var telescopesTask = TelescopeService.GetTelescopesAsync();
            var eyepiecesTask = TelescopeService.GetEyepiecesAsync();
            var lensesTask = TelescopeService.GetLensesAsync();
            var sensorsTask = TelescopeService.GetSensorsAsync();

            await Task.WhenAll(telescopesTask, eyepiecesTask, lensesTask, sensorsTask);

            telescopes = telescopesTask.Result.ToList();
            eyepieces = eyepiecesTask.Result.ToList();
            lenses = lensesTask.Result.ToList();
            sensors = sensorsTask.Result.ToList();
        }
        catch (Exception exception)
        {
            setupLoadError = $"Unable to load telescope equipment: {exception.Message}";
        }
    }

    private enum MessierSort
    {
        Name,
        RiseTime,
        SetTime
    }

    private enum SetupDeviceType
    {
        Eyepiece,
        Sensor
    }

}