@using HomeServerPage.Data.Weather

@if (Astronomy is not null)
{
    <div class="moon-phase @(Large ? "moon-phase-large" : null)"
         aria-label="@($"{Astronomy.MoonPhase}, {Astronomy.MoonIlluminationPercent}% illuminated")">
        <span class="moon-phase-visual">
            <svg class="moon-phase-disc" viewBox="0 0 100 100" aria-hidden="true">
                <circle class="moon-phase-shadow" cx="50" cy="50" r="49" />
                @if (LitAreaPath is not null)
                {
                    <path class="moon-phase-lit" d="@LitAreaPath" />
                }
            </svg>
            @if (ShouldDisplayImage)
            {
                <img class="moon-phase-image"
                     src="@MoonImageUrl"
                     alt=""
                     aria-hidden="true"
                     loading="lazy"
                     decoding="async"
                     @onerror="HandleMoonImageError" />
            }
        </span>
        <div class="moon-phase-details">
            <strong>@Astronomy.MoonPhase</strong>
            <span>@Astronomy.MoonIlluminationPercent% illuminated</span>
            <span class="moon-phase-illumination" aria-hidden="true">
                <span style="width: @Astronomy.MoonIlluminationPercent%;"></span>
            </span>
            @if (MoonVisualizationUrl is not null)
            {
                <a class="moon-phase-credit" href="@MoonVisualizationUrl" target="_blank" rel="noopener noreferrer">
                    NASA SVS
                </a>
            }
        </div>
    </div>
}
