@using AstroCalc.Observation
@using HomeServerPage.Data.Astronomy

@if (TableLayout)
{
    <div class="astronomy-planet-table-wrapper">
        <table class="astronomy-planet-table">
            <thead>
                <tr>
                    <th scope="col">Object</th>
                    <th scope="col">Rise</th>
                    <th scope="col">Set</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var observation in VisibleObservations)
                {
                    <tr data-planet="@observation.Key">
                        <th scope="row">
                            <img class="astronomy-planet-table-icon"
                                 src="@GetObservationImageUrl(observation.Key)"
                                 alt="" />
                            @observation.Name
                        </th>
                        <td>@observation.TransitResult.RiseUT.FormatUtHours(RequestDateUtc, AstronomyDefaults.LocalTimeZone)</td>
                        <td>@observation.TransitResult.SetUT.FormatUtHours(RequestDateUtc, AstronomyDefaults.LocalTimeZone)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="astronomy-planet-items @(Compact ? "astronomy-planet-items-compact" : null)">
        @foreach (var observation in VisibleObservations)
        {
            <article class="astronomy-object-card astronomy-planet-item" data-planet="@observation.Key">
                <img class="astronomy-planet-icon"
                     src="@GetObservationImageUrl(observation.Key)"
                     alt="@observation.Name" />

                <div class="astronomy-planet-details">
                    <h3 class="h5 mb-2">@observation.Name</h3>

                    @foreach (var value in GetResultValues(observation.TransitResult))
                    {
                        <div class="astronomy-planet-result">
                            <span class="text-body-secondary">@value.Label</span>
                            <span>@value.Value</span>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}
