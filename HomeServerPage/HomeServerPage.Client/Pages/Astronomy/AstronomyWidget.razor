@using HomeServerPage.Data.Astronomy

@inject IAstronomyService AstronomyService

<section class="dashboard-card dashboard-card-astronomy astronomy-widget card h-100" aria-labelledby="astronomy-widget-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <svg class="dashboard-card-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m14.5 4.5 5 5M12 7l5 5M3 21l7.5-7.5" />
                    <path d="m6 18 3 3M4 13l7-7 4 4-7 7zM15 15l5 5" />
                </svg>
                <div>
                    <h2 id="astronomy-widget-heading" class="dashboard-card-title">Astronomy</h2>
                    <p class="dashboard-card-subtitle">Solar, planetary, and lunar visibility for Szczecin.</p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary dashboard-card-action" href="/astronomy">Open sky tools</a>
        </div>

        @if (solarSystemObservations is null)
        {
            <p class="dashboard-card-status" role="status">Loading celestial observations…</p>
        }
        else if (loadError is not null)
        {
            <p class="dashboard-card-status is-error mb-0" role="alert">@loadError</p>
        }
        else
        {
            <p class="dashboard-card-context">
                Rise and set times for @observationTime?.ToString("g")
            </p>
            <PlanetObservationList Observations="solarSystemObservations" RequestDateUtc="requestDateUtc" Compact="true" />

            @if (visibleMessierObservations.Count > 0)
            {
                <section class="messier-widget dashboard-card-subsection" aria-labelledby="visible-messier-heading">
                    <div class="dashboard-subsection-header">
                        <h3 id="visible-messier-heading" class="dashboard-subsection-title">Deep sky at sunset</h3>
                        <span class="badge rounded-pill dashboard-count-badge">@visibleMessierObservations.Count visible</span>
                    </div>

                    <div class="messier-observation-items">
                        @foreach (var observation in visibleMessierObservations)
                        {
                            <article class="astronomy-object-card messier-observation-item">
                                <span class="messier-observation-name">@observation.Name</span>
                                <div class="messier-observation-times">
                                    <span>Rise @observation.TransitResult.RiseUT.FormatUtHours(requestDateUtc, AstronomyDefaults.LocalTimeZone)</span>
                                    <span>Set @observation.TransitResult.SetUT.FormatUtHours(requestDateUtc, AstronomyDefaults.LocalTimeZone)</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </div>
</section>

@code {
    private IReadOnlyList<AstronomyObservation>? solarSystemObservations;
    private IReadOnlyList<AstronomyObservation> visibleMessierObservations = [];
    private DateTime requestDateUtc;
    private DateTimeOffset? observationTime;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        var nowInPoland = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, AstronomyDefaults.LocalTimeZone);
        requestDateUtc = nowInPoland.UtcDateTime;
        observationTime = nowInPoland;

        try
        {
            var solarSystemObservationsTask = AstronomyObservationLoader.LoadSolarSystemAsync(
                AstronomyService,
                requestDateUtc,
                AstronomyDefaults.Location);
            var messierObservationsTask = AstronomyObservationLoader.LoadMessierCatalogAsync(
                AstronomyService,
                requestDateUtc,
                AstronomyDefaults.Location);

            var solarObservations = await solarSystemObservationsTask;
            solarSystemObservations = solarObservations.Where(p => p.Key != "uranus" && p.Key != "neptune").ToList();
            var sunsetUtHours = solarSystemObservations.Single(observation => observation.Key == "sun").TransitResult.SetUT;
            var messierObservations = await messierObservationsTask;

            visibleMessierObservations = messierObservations
                .Where(observation => IsAboveHorizonAt(observation, sunsetUtHours))
                .OrderBy(observation => observation.Name)
                .Take(3)
                .ToArray();
        }
        catch (Exception exception)
        {
            loadError = $"Unable to load celestial observations: {exception.Message}";
        }
    }

    private static bool IsAboveHorizonAt(AstronomyObservation observation, double utHours)
    {
        var riseUtHours = observation.TransitResult.RiseUT;
        var setUtHours = observation.TransitResult.SetUT;

        if (setUtHours - utHours < 2d)
        {
            return false;
        }

        return riseUtHours <= setUtHours
            ? utHours >= riseUtHours && utHours <= setUtHours
            : utHours >= riseUtHours || utHours <= setUtHours;
    }

}
