@using HomeServerPage.Data
@using HomeServerPage.Data.Astronomy
@using HomeServerPage.Data.Weather
@implements IDisposable

@inject IAstronomyService AstronomyService
@inject IWeatherService WeatherService
@inject IDateTimeService DateTimeService
@inject HomeServerPage.Client.Data.TabletDashboardRefreshService DashboardRefreshService

<section class="dashboard-card dashboard-card-astronomy astronomy-widget card h-100" aria-labelledby="astronomy-widget-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <span class="dashboard-card-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
                <div>
                    <h2 id="astronomy-widget-heading" class="dashboard-card-title">Astronomy</h2>
                    <p class="dashboard-card-subtitle">Solar, planetary, and lunar visibility for Szczecin.</p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary dashboard-card-action" href="@DetailsHref">Open sky tools</a>
        </div>

        @if (this.isLoading)
        {
            <p class="dashboard-card-status" role="status">Loading celestial observations…</p>
        }
        else if (this.loadError is not null)
        {
            <p class="dashboard-card-status is-error mb-0" role="alert">@this.loadError</p>
        }
        else
        {
            @if (!CompactTablet)
            {
                <p class="dashboard-card-context">
                    Rise and set times for @this.observationTime?.ToString("g")
                </p>
            }
            <div class="astronomy-widget-content">
                <div class="astronomy-widget-observations">
                    <PlanetObservationList Observations="@this.solarSystemObservations"
                                           RequestDateUtc="@this.requestDateUtc"
                                           Compact="true"
                                           TableLayout="true" />
                </div>
                <div class="astronomy-widget-moon">
                    <MoonPhase Astronomy="@this.moonAstronomy" Large="true" />
                </div>
            </div>

        }
    </div>
</section>

@code {
    [Parameter]
    public string DetailsHref { get; set; } = "/astronomy";

    [Parameter]
    public bool CompactTablet { get; set; }

    [Parameter]
    public bool AutoRefresh { get; set; }

    private IReadOnlyList<AstronomyObservation> solarSystemObservations = [];
    private WeatherAstronomy? moonAstronomy;
    private DateTime requestDateUtc;
    private DateTimeOffset? observationTime;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        if (AutoRefresh)
        {
            DashboardRefreshService.RefreshRequested += this.HandleRefreshRequestedAsync;
        }

        await this.LoadObservationsAsync();
    }

    private Task HandleRefreshRequestedAsync() => InvokeAsync(async () =>
    {
        await this.LoadObservationsAsync();
        this.StateHasChanged();
    });

    private async Task LoadObservationsAsync()
    {
        this.isLoading = true;
        this.loadError = null;
        this.solarSystemObservations = [];
        this.moonAstronomy = null;

        try
        {
            await DateTimeService.SyncAsync();
            var nowInPoland = DateTimeService.Now;
            this.requestDateUtc = DateTimeService.UtcNow;
            this.observationTime = nowInPoland;

            var solarSystemObservationsTask = AstronomyObservationLoader.LoadSolarSystemAsync(
                AstronomyService,
                this.requestDateUtc,
                AstronomyDefaults.Location);
            var moonAstronomyTask = WeatherService.GetAstronomyAsync(
                DateOnly.FromDateTime(this.requestDateUtc));
            await Task.WhenAll(solarSystemObservationsTask, moonAstronomyTask);
            var solarObservations = await solarSystemObservationsTask;
            this.solarSystemObservations = solarObservations.Where(p => p.Key != "uranus" && p.Key != "neptune").ToList();
            this.moonAstronomy = await moonAstronomyTask;
        }
        catch (Exception exception)
        {
            this.loadError = $"Unable to load celestial observations: {exception.Message}";
        }
        finally
        {
            this.isLoading = false;
        }
    }

    public void Dispose()
    {
        if (AutoRefresh)
        {
            DashboardRefreshService.RefreshRequested -= this.HandleRefreshRequestedAsync;
        }
    }
}
