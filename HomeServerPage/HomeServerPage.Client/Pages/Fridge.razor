@page "/fridge"
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using HomeServerPage.Data.Fridge
@inject IFridgeService FridgeService

<PageTitle>My Fridge</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="h3 mb-1">My Fridge</h1>
                <p class="text-body-secondary mb-0">Add a new product to your fridge inventory.</p>
            </div>

            <EditForm Model="@EditedFridgeItem" OnValidSubmit="OnValidFridgeItemSubmitAsync" FormName="FridgeAddForm" method="post">
                <DataAnnotationsValidator/>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label label-truncate" for="fridge-name">Name</label>
                        <InputText id="fridge-name" class="form-control" @bind-Value="@EditedFridgeItem.Name" placeholder="Milk" />
                        <ValidationMessage For="@(() => @EditedFridgeItem.Name)" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-quantity">Quantity</label>
                        <InputNumber id="fridge-quantity" class="form-control" @bind-Value="@EditedFridgeItem.QuanitityValue" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-quantity-type">Quantity type</label>
                        <InputSelect id="fridge-quantity-type" class="form-select" @bind-Value="@EditedFridgeItem.QuantityType">
                            @foreach (var quantityType in QuantityTypes)
                            {
                                <option value="@quantityType">@quantityType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-added-date">Added Date</label>
                        <InputDate id="fridge-added-date" class="form-control" @bind-Value="@EditedFridgeItem.AddedDate" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-expiration-date">Expiration Date</label>
                        <InputDate id="fridge-expiration-date" class="form-control" @bind-Value="@EditedFridgeItem.ExpirationDate" />
                        <ValidationMessage For="@(() => @EditedFridgeItem.ExpirationDate)" />
                    </div>


                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-open-date">Open Date</label>
                        <InputDate id="fridge-open-date" class="form-control" @bind-Value="@EditedFridgeItem.OpenDate" />
                        <ValidationMessage For="@(() => @EditedFridgeItem.OpenDate)" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-time-after-open">Time after open (hours)</label>
                        <InputNumber id="fridge-time-after-open" class="form-control" @bind-Value="@EditedFridgeItem.TimeAfterOpen" />
                    </div>

                    <div class="col-12 d-grid d-md-flex justify-content-md-end pt-2">
                        <button type="submit" class="btn btn-primary px-4">Add to Fridge</button>
                    </div>
                </div>
            </EditForm>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 mt-4 mt-md-5">
                <div>
                    <h2 class="h4 mb-1">Fridge items</h2>
                    <p class="text-body-secondary mb-0">Current products stored in the fridge.</p>
                </div>
                <span class="badge text-bg-light border">@Items.Count item(s)</span>
            </div>

            @if (Items.Count == 0)
            {
                <div class="alert alert-light border mb-0" role="status">
                    No fridge items yet. Add your first product using the form above.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fridge-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col" class="d-none d-sm-table-cell">Qty</th>
                                <th scope="col" class="d-none d-lg-table-cell">Type</th>
                                <th scope="col" class="d-none d-md-table-cell">Added</th>
                                <th scope="col" class="d-none d-xl-table-cell">Opened</th>
                                <th scope="col">Expires</th>
                                <th scope="col" class="d-none d-xl-table-cell">Time (hrs)</th>
                                <th scope="col" aria-label="Remove"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Items)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <div>@item.Name</div>
                                        <small class="text-muted d-sm-none">@item.QuantityValue @item.QuantityType</small>
                                    </td>
                                    <td class="d-none d-sm-table-cell">@item.QuantityValue</td>
                                    <td class="d-none d-lg-table-cell">@item.QuantityType</td>
                                    <td class="d-none d-md-table-cell">@item.AddedDate.ToString("d")</td>
                                    <td class="d-none d-xl-table-cell">@(item.OpenDate.HasValue ? item.OpenDate.Value.ToString("d") : "-")</td>
                                    <td>@item.ExpirationDate.ToString("d")</td>
                                    <td class="d-none d-xl-table-cell">@item.TimeAfterOpen.TotalHours</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItemAsync(item)" title="Remove">
                                            🗑️
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {

    public FridgeItemModel EditedFridgeItem { get; set; } = FridgeItemModel.CreateClearEditedFridgeItem();

    public List<FridgeItem> Items { get; set; } = [];

    private static IReadOnlyList<QuantityType> QuantityTypes { get; } = Enum.GetValues<QuantityType>();

    protected override async Task OnInitializedAsync()
    {
        Items = await FridgeService.GetItemsAsync();
        await base.OnInitializedAsync();
    }

    private async Task OnValidFridgeItemSubmitAsync(EditContext args)
    {
        await FridgeService.AddItemAsync(this.EditedFridgeItem.ToFridgeItem());
        this.EditedFridgeItem = FridgeItemModel.CreateClearEditedFridgeItem();
        Items = await FridgeService.GetItemsAsync();
    }

    private async Task RemoveItemAsync(FridgeItem item)
    {
        var removed = await FridgeService.RemoveItemAsync(item.Id);
        if (removed)
        {
            Items = await FridgeService.GetItemsAsync();
        }
        else
        {
            Items = await FridgeService.GetItemsAsync();
        }
    }

    public class FridgeItemModel : IValidatableObject
    {
        [Required]
        public string? Name { get; set; }

        [Range(0, int.MaxValue)]
        public int QuanitityValue { get; set; }

        public QuantityType QuantityType { get; set; }

        public DateTime AddedDate { get; set; }

        public DateTime? OpenDate { get; set; }

        public DateTime ExpirationDate { get; set; }

        public int TimeAfterOpen { get; set; }

        public FridgeItem ToFridgeItem()
            => new(0, Name ?? throw new NullReferenceException(), QuanitityValue, QuantityType, AddedDate, OpenDate, ExpirationDate, TimeSpan.FromHours(TimeAfterOpen));

        public static FridgeItemModel CreateClearEditedFridgeItem()
            => new FridgeItemModel
                {
                    Name = "Name",
                    QuanitityValue = 1,
                    QuantityType = QuantityType.Unit,
                    AddedDate = DateTime.Now,
                    OpenDate = null,
                    ExpirationDate = DateTime.Now.AddDays(1),
                    TimeAfterOpen = 0
                };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (ExpirationDate < AddedDate)
            {
                yield return new ValidationResult(
                    $"Expiration Date cannot be earlier than Added Date",
                    new[] { nameof(ExpirationDate) });
            }

            if (OpenDate is not null && OpenDate < AddedDate)
            {
                yield return new ValidationResult(
                    $"Open Date cannot be earlier than AddedDate",
                    new[] { nameof(OpenDate) });
            }
        }
    }
}
