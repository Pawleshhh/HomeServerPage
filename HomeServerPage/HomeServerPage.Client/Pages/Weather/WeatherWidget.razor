@using HomeServerPage.Data.Weather
@inject IWeatherService WeatherService

<section class="dashboard-card dashboard-card-weather card h-100" aria-labelledby="weather-widget-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <span class="dashboard-card-icon" aria-hidden="true"><i class="bi @WeatherIconClass"></i></span>
                <div>
                    <h2 id="weather-widget-heading" class="dashboard-card-title">Weather</h2>
                    <p class="dashboard-card-subtitle">Current conditions in @LocationLabel.</p>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <p class="dashboard-card-status" role="status">Loading weather…</p>
        }
        else if (loadError is not null)
        {
            <p class="dashboard-card-status is-error mb-0" role="alert">@loadError</p>
        }
        else if (snapshot is not null)
        {
            <div class="weather-summary">
                <div class="weather-temperature">
                    <span class="weather-temperature-value">@snapshot.TemperatureCelsius</span>
                    <span class="weather-temperature-unit">°C</span>
                </div>
                <div class="weather-condition">
                    <span class="weather-condition-icon" role="img" aria-label="@snapshot.Condition">
                        <i class="bi @WeatherIconClass" aria-hidden="true"></i>
                    </span>
                    <span>Feels like @snapshot.FeelsLikeCelsius°C</span>
                </div>
            </div>
            <dl class="weather-details">
                <div>
                    <dt><i class="bi bi-droplet-fill" aria-hidden="true"></i> Humidity</dt>
                    <dd>@snapshot.HumidityPercent%</dd>
                </div>
                <div>
                    <dt><i class="bi bi-wind" aria-hidden="true"></i> Wind</dt>
                    <dd>@snapshot.WindSpeedKilometersPerHour km/h</dd>
                </div>
            </dl>
        }
    </div>
</section>

@code {
    private WeatherSnapshot? snapshot;
    private bool isLoading = true;
    private string? loadError;

    private string LocationLabel => snapshot?.Location ?? "Szczecin";
    private string WeatherIconClass => WeatherConditionIcons.GetIconClass(snapshot?.Condition);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            snapshot = await WeatherService.GetCurrentAsync();
        }
        catch (Exception)
        {
            loadError = "Could not load weather.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
