@using HomeServerPage.Data.Weather
@implements IDisposable
@inject IWeatherService WeatherService
@inject HomeServerPage.Client.Data.TabletDashboardRefreshService DashboardRefreshService

<section class="dashboard-card dashboard-card-weather card h-100" aria-labelledby="weather-widget-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <DashboardCardRefreshIcon IconClass="@this.WeatherIconClass"
                                          RefreshLabel="Refresh weather"
                                          RefreshEnabled="@AutoRefresh"
                                          IsLoading="@this.isLoading"
                                          OnRefresh="this.HandleRefreshRequestedAsync" />
                <div>
                    <h2 id="weather-widget-heading" class="dashboard-card-title">Weather</h2>
                    <p class="dashboard-card-subtitle">Current conditions in @this.LocationLabel.</p>
                </div>
            </div>
        </div>

        @if (this.isLoading)
        {
            <p class="dashboard-card-status" role="status">Loading weather…</p>
        }
        else if (this.loadError is not null)
        {
            <p class="dashboard-card-status is-error mb-0" role="alert">@this.loadError</p>
        }
        else if (this.snapshot is not null)
        {
            <div class="weather-widget-content">
                <div class="weather-current">
                    <div class="weather-summary">
                        <div class="weather-temperature-overview">
                            <div class="weather-temperature">
                                <span class="weather-temperature-value">@this.snapshot.TemperatureCelsius.ToString("0.#")</span>
                                <span class="weather-temperature-unit">°C</span>
                            </div>
                            @if (this.forecastDay is not null)
                            {
                                <div class="weather-temperature-range" title="Today's maximum / minimum temperatures">
                                    <span class="visually-hidden">Today's maximum:</span>
                                    <span class="weather-temperature-value">@this.forecastDay.MaxTemperatureCelsius.ToString("0.#")°</span>
                                    <span class="weather-temperature-minimum"><span aria-hidden="true">/ </span><span class="visually-hidden">Minimum:</span>@this.forecastDay.MinTemperatureCelsius.ToString("0.#")°C</span>
                                </div>
                            }
                        </div>
                        <div class="weather-condition">
                            <span class="weather-condition-icon" role="img" aria-label="@this.snapshot.Condition.Text">
                                <i class="bi @this.WeatherIconClass" aria-hidden="true"></i>
                            </span>
                            <span>@this.snapshot.Condition.Text · feels like @this.snapshot.FeelsLikeCelsius.ToString("0.#")°C</span>
                        </div>
                    </div>
                    <dl class="weather-details">
                        <div>
                            <dt><i class="bi bi-droplet-fill" aria-hidden="true"></i> Humidity</dt>
                            <dd>@this.snapshot.HumidityPercent%</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-wind" aria-hidden="true"></i> Wind</dt>
                            <dd>@this.snapshot.WindSpeedKilometersPerHour.ToString("0.#") km/h @this.snapshot.WindDirection</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-cloud-rain" aria-hidden="true"></i> Rain chance</dt>
                            <dd>@this.RainChancePercent%</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-moisture" aria-hidden="true"></i> Precipitation</dt>
                            <dd>@this.snapshot.PrecipitationMillimeters.ToString("0.#") mm</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-speedometer2" aria-hidden="true"></i> Pressure</dt>
                            <dd>@this.snapshot.PressureMillibars.ToString("0.#") mb</dd>
                        </div>
                        <div>
                            <dt><i class="bi bi-brightness-high" aria-hidden="true"></i> UV</dt>
                            <dd>@this.snapshot.UvIndex.ToString("0.#")</dd>
                        </div>
                    </dl>
                    @if (this.nextDayForecast is not null)
                    {
                        <dl class="weather-details weather-next-day">
                            <div>
                                <dt>Tomorrow max</dt>
                                <dd>@this.nextDayForecast.MaxTemperatureCelsius.ToString("0.#")°C</dd>
                            </div>
                            <div>
                                <dt>Tomorrow min</dt>
                                <dd>@this.nextDayForecast.MinTemperatureCelsius.ToString("0.#")°C</dd>
                            </div>
                            <div>
                                <dt>Tomorrow rain chance</dt>
                                <dd>@this.nextDayForecast.ChanceOfRainPercent%</dd>
                            </div>
                        </dl>
                    }
                </div>
            </div>
        }
    </div>
</section>
