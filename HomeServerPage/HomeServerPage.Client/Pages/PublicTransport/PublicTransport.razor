@page "/public-transport"
@using HomeServerPage.Data.PublicTransport
@inject IPublicTransportService PublicTransportService

<PageTitle>Public Transport</PageTitle>

<div class="container-fluid">
    <PageHeader Title="Public Transport"
                Description="See the next departures from your usual stop."
                Accent="transport">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="LoadBoardsAsync" disabled="@isLoading">
                @(isLoading ? "Refreshing..." : "Refresh")
            </button>
        </Actions>
    </PageHeader>

    @if (isLoading && boards.Count == 0)
    {
        <div class="transport-page-state" role="status">
            <span class="transport-state-dot" aria-hidden="true"></span>
            Loading departure boards…
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="transport-page-state is-error alert" role="alert">@errorMessage</div>
    }
    else if (boards.Count == 0)
    {
        <div class="transport-page-state is-empty" role="status">
            No departure boards are available right now.
        </div>
    }
    else
    {
        <section class="transport-board-grid" aria-label="Departure boards">
            @foreach (var board in boards)
            {
                <article class="transport-page-board" aria-labelledby="transport-page-stop-@board.Stop.Number">
                    <header class="transport-page-board-header">
                        <div>
                            <h2 id="transport-page-stop-@board.Stop.Number">Lubomirskiego</h2>
                            <p>Upcoming departures from this stop</p>
                        </div>
                        <span class="transport-stop-badge">Stop @board.Stop.Number</span>
                    </header>

                    <div class="transport-page-departures">
                        @foreach (var departure in board.Departures.OrderBy(d => d.DepartureTime.Estimated))
                        {
                            <div class="transport-page-departure @(departure.DepartureTime.Canceled ? "is-canceled" : null)">
                                <span class="transport-page-line" style="background-color: @PublicTransportLineColors.GetColor(departure.Line.Number); color: @PublicTransportLineColors.GetTextColor(departure.Line.Number);">
                                    @departure.Line.Number
                                </span>
                                <div class="transport-page-direction">
                                    <span>@departure.Trip.Headsign.Short</span>
                                    @if (departure.DepartureTime.Canceled)
                                    {
                                        <small>Cancelled</small>
                                    }
                                </div>
                                <div class="transport-page-time">
                                    <span>@departure.DepartureTime.Estimated.ToLocalTime().ToString("HH:mm")</span>
                                    @if (departure.DepartureTime.DepartingNow)
                                    {
                                        <span class="transport-now-badge">Now</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    private List<DepartureBoard> boards = [];
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardsAsync();
    }

    private async Task LoadBoardsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            boards = await PublicTransportService.GetDepartureBoardsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Could not load the departure boards.";
        }
        finally
        {
            isLoading = false;
        }
    }

}
