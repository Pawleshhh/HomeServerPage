@using HomeServerPage.Data.PublicTransport
@implements IDisposable
@inject IPublicTransportService PublicTransportService
@inject HomeServerPage.Client.Data.TabletDashboardRefreshService DashboardRefreshService

<section class="dashboard-card dashboard-card-transport card h-100" aria-labelledby="public-transport-widget-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <span class="dashboard-card-icon" aria-hidden="true"><i class="bi bi-bus-front-fill"></i></span>
                <div>
                    <h2 id="public-transport-widget-heading" class="dashboard-card-title">Public transport</h2>
                    <p class="dashboard-card-subtitle">Next departures from Lubomirskiego.</p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary dashboard-card-action" href="@DetailsHref">Open departures</a>
        </div>

        @if (this.errorMessage is not null)
        {
            <p class="dashboard-card-status is-error mb-0" role="alert">@this.errorMessage</p>
        }
        else if (this.Boards is null)
        {
            <p class="dashboard-card-status" role="status">Loading departures…</p>
        }
        else if (this.Boards.Count == 0)
        {
            <p class="dashboard-card-status is-empty mb-0">No departures available.</p>
        }
        else
        {
            <div class="transport-table-scroll @(CompactTablet ? "transport-table-scroll-tablet" : null)">
                <table class="transport-directions-table">
                    <thead>
                        <tr>
                            @foreach (var board in this.Boards)
                            {
                                <th scope="col">Lubomirskiego <span class="text-body-secondary">(@board.Stop.Number)</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @foreach (var board in this.Boards)
                            {
                                <td>
                                    <div class="list-group list-group-flush transport-departures">
                                        @foreach (var departure in board.Departures.OrderBy(d => d.DepartureTime.Estimated))
                                        {
                                            <div class="list-group-item transport-departure-row">
                                                <span class="badge transport-line-badge" style="background-color: @PublicTransportLineColors.GetColor(departure.Line.Number); color: @PublicTransportLineColors.GetTextColor(departure.Line.Number)">
                                                    @departure.Line.Number
                                                </span>
                                                <span class="transport-destination">@departure.Trip.Headsign.Short</span>
                                                <span class="transport-time">
                                                    @departure.DepartureTime.Estimated.ToLocalTime().ToString("HH:mm")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
