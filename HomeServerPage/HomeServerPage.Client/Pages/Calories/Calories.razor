@implements IAsyncDisposable
@using System.Globalization
@using HomeServerPage.Data.Calories
@using HomeServerPage.Data.Notifications
@inject ICaloriesService CaloriesService
@inject IRealtimeNotificationEventSource NotificationEventSource
@inject IJSRuntime JS
@inject ILogger<Calories> Logger

<PageTitle>Calories</PageTitle>

<div class="container-fluid calories-page">
    <PageHeader Title="Calories"
                Description="Track daily food, nutrition, and calorie history."
                Accent="calories" />

    @if (isLoading)
    {
        <div class="calories-loading" role="status">Loading your calorie tracker…</div>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-danger" role="alert">
            <p class="mb-2">@loadError</p>
            <button class="btn btn-outline-secondary" type="button" @onclick="RetryLoadingAsync">Try again</button>
        </div>
    }
    else
    {
        @if (statusMessage is not null)
        {
            <div class="alert @(statusIsError ? "alert-danger" : "alert-success") calories-status" role="status" aria-live="polite">
                @statusMessage
            </div>
        }

        <div class="calories-tabs" role="tablist" aria-label="Calories tracker sections">
            <button id="calories-daily-tab"
                    class="calories-tab @(activeTab == CaloriesTab.Daily ? "active" : null)"
                    type="button"
                    role="tab"
                    aria-selected="@(activeTab == CaloriesTab.Daily)"
                    aria-controls="calories-daily-panel"
                    @onclick="() => SelectTabAsync(CaloriesTab.Daily)">
                <i class="bi bi-calendar-day" aria-hidden="true"></i>
                Daily log
            </button>
            <button id="calories-foods-tab"
                    class="calories-tab @(activeTab == CaloriesTab.Foods ? "active" : null)"
                    type="button"
                    role="tab"
                    aria-selected="@(activeTab == CaloriesTab.Foods)"
                    aria-controls="calories-foods-panel"
                    @onclick="() => SelectTabAsync(CaloriesTab.Foods)">
                <i class="bi bi-bookmark-heart" aria-hidden="true"></i>
                Foods
            </button>
            <button id="calories-statistics-tab"
                    class="calories-tab @(activeTab == CaloriesTab.Statistics ? "active" : null)"
                    type="button"
                    role="tab"
                    aria-selected="@(activeTab == CaloriesTab.Statistics)"
                    aria-controls="calories-statistics-panel"
                    @onclick="() => SelectTabAsync(CaloriesTab.Statistics)">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                Statistics
            </button>
        </div>

        @if (activeTab == CaloriesTab.Daily)
        {
            <section id="calories-daily-panel"
                     class="calories-tab-panel @(isTabletMode ? "calories-tablet-daily" : null)"
                     role="tabpanel"
                     aria-labelledby="calories-daily-tab"
                     tabindex="0">
                <div class="calories-date-toolbar @(isTabletMode ? "calories-tablet-date-toolbar" : null)">
                    <button class="btn btn-outline-secondary calories-day-step" type="button" aria-label="Previous day" @onclick="GoToPreviousDayAsync">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="calories-date-picker">
                        <label class="visually-hidden" for="calories-selected-date">Selected date</label>
                        <InputDate id="calories-selected-date"
                                   class="form-control"
                                   TValue="DateOnly"
                                   Value="selectedDate"
                                   ValueChanged="OnSelectedDateChangedAsync"
                                   ValueExpression="() => selectedDate"
                                   Max="today.ToDateTime(TimeOnly.MinValue)" />
                    </div>
                    <button class="btn btn-outline-secondary calories-day-step"
                            type="button"
                            aria-label="Next day"
                            disabled="@(selectedDate >= today)"
                            @onclick="GoToNextDayAsync">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <button class="btn btn-outline-primary calories-today-button"
                            type="button"
                            disabled="@(selectedDate == today)"
                            @onclick="GoToTodayAsync">
                        Today
                    </button>
                </div>

                <div class="calories-daily-overview @(isTabletMode ? "calories-tablet-overview" : null)">
                    <section class="calories-summary-card calories-total-card" aria-labelledby="daily-total-heading">
                        <div class="calories-summary-heading">
                            <div>
                                <p class="calories-eyebrow">Selected day</p>
                                <h2 id="daily-total-heading">@(isTabletMode
                                    ? selectedDate.ToString("ddd, d MMM", CultureInfo.CurrentCulture)
                                    : selectedDate.ToString("dddd, d MMMM yyyy", CultureInfo.CurrentCulture))</h2>
                            </div>
                            <span class="calories-summary-icon" aria-hidden="true"><i class="bi bi-fire"></i></span>
                        </div>
                        <p class="calories-total-value"><strong>@DailyCalories.ToString("N0", CultureInfo.CurrentCulture)</strong><span>kcal</span></p>
                        @if (dailyGoal is int goal)
                        {
                            <div class="calories-goal-progress" role="progressbar" aria-label="Daily calorie goal progress" aria-valuemin="0" aria-valuemax="@goal" aria-valuenow="@Math.Min(DailyCalories, goal)">
                                <span style="width: @(GoalProgressPercent)%"></span>
                            </div>
                            <p class="calories-goal-caption">
                                @if (DailyCalories <= goal)
                                {
                                    <span>@((goal - DailyCalories).ToString("N0", CultureInfo.CurrentCulture)) kcal remaining of @goal.ToString("N0", CultureInfo.CurrentCulture)</span>
                                }
                                else
                                {
                                    <span>@((DailyCalories - goal).ToString("N0", CultureInfo.CurrentCulture)) kcal over your @goal.ToString("N0", CultureInfo.CurrentCulture) goal</span>
                                }
                            </p>
                        }
                        else if (!isTabletMode)
                        {
                            <p class="calories-goal-caption">Set a daily goal below to track progress.</p>
                        }
                    </section>

                    @if (!isTabletMode)
                    {
                        <section class="calories-summary-card" aria-labelledby="weekly-total-heading">
                            <div class="calories-summary-heading">
                                <div>
                                    <p class="calories-eyebrow">Monday–Sunday</p>
                                    <h2 id="weekly-total-heading">Selected week</h2>
                                </div>
                                <span class="calories-summary-icon" aria-hidden="true"><i class="bi bi-calendar-week"></i></span>
                            </div>
                            <p class="calories-total-value"><strong>@WeeklyCalories.ToString("N0", CultureInfo.CurrentCulture)</strong><span>kcal</span></p>
                            <p class="calories-goal-caption">@WeekStart.ToString("d MMM", CultureInfo.CurrentCulture) – @WeekEnd.ToString("d MMM", CultureInfo.CurrentCulture)</p>
                        </section>

                        <section class="calories-summary-card calories-goal-card" aria-labelledby="calories-goal-heading">
                            <div class="calories-summary-heading">
                                <div>
                                    <p class="calories-eyebrow">Applies to every day</p>
                                    <h2 id="calories-goal-heading">Daily goal</h2>
                                </div>
                                <span class="calories-summary-icon" aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                            </div>
                            <EditForm class="calories-goal-form" Model="goalDraft" OnValidSubmit="SaveGoalAsync" FormName="CaloriesGoalForm">
                                <DataAnnotationsValidator />
                                <div class="calories-goal-input-row">
                                    <label class="visually-hidden" for="calories-goal-input">Daily calorie goal in kcal</label>
                                    <InputNumber id="calories-goal-input" class="form-control" @bind-Value="goalDraft.Calories" min="1" step="1" placeholder="e.g. 2000" />
                                    <button class="btn btn-primary" type="submit" disabled="@isSavingGoal">Save</button>
                                </div>
                                <ValidationMessage For="() => goalDraft.Calories" />
                            </EditForm>
                        </section>
                    }
                </div>

                <section class="calories-macro-summary @(isTabletMode ? "calories-tablet-macro-summary" : null)"
                         aria-label="@(isTabletMode ? "Daily macronutrient totals" : "Daily and weekly macronutrient totals")">
                    <div>
                        <span>Today · recorded</span>
                        <strong>Carbs @FormatMacro(DailyCarbohydrates) · Protein @FormatMacro(DailyProtein) · Fat @FormatMacro(DailyFat)</strong>
                    </div>
                    @if (!isTabletMode)
                    {
                        <div>
                            <span>Selected week · recorded</span>
                            <strong>Carbs @FormatMacro(WeeklyCarbohydrates) · Protein @FormatMacro(WeeklyProtein) · Fat @FormatMacro(WeeklyFat)</strong>
                        </div>
                        <p class="calories-macro-note">Only entries with recorded macro values are included in these totals.</p>
                    }
                </section>

                @if (isTabletMode && showTabletEntryForm)
                {
                    <button class="calories-tablet-entry-backdrop"
                            type="button"
                            aria-label="Close food entry form"
                            @onclick="CloseTabletEntryForm"></button>
                }

                @if (!isTabletMode || showTabletEntryForm)
                {
                <section class="calories-panel calories-entry-panel @(isTabletMode ? "calories-tablet-entry-dialog" : null)"
                         aria-labelledby="log-food-heading"
                         role="@(isTabletMode ? "dialog" : null)"
                         aria-modal="@(isTabletMode ? "true" : null)">
                    <div class="calories-panel-heading">
                        <div>
                            @if (!isTabletMode)
                            {
                                <p class="calories-eyebrow">Add to @selectedDate.ToString("d MMM", CultureInfo.CurrentCulture)</p>
                            }
                            <h2 id="log-food-heading">Log food</h2>
                        </div>
                        @if (isTabletMode)
                        {
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CloseTabletEntryForm">Close</button>
                        }
                        else
                        {
                            <span class="calories-item-count">@dayEntries.Count item(s)</span>
                        }
                    </div>

                    <div class="calories-entry-mode" role="group" aria-label="Food entry type">
                        <button class="calories-entry-mode-button @(entryMode == EntryMode.SavedFood ? "active" : null)"
                                type="button"
                                aria-pressed="@(entryMode == EntryMode.SavedFood)"
                                @onclick="() => entryMode = EntryMode.SavedFood">
                            Saved food
                        </button>
                        <button class="calories-entry-mode-button @(entryMode == EntryMode.CustomFood ? "active" : null)"
                                type="button"
                                aria-pressed="@(entryMode == EntryMode.CustomFood)"
                                @onclick="() => entryMode = EntryMode.CustomFood">
                            One-time custom food
                        </button>
                    </div>

                    @if (entryMode == EntryMode.SavedFood)
                    {
                        <EditForm class="calories-entry-form" Model="savedEntryDraft" OnValidSubmit="AddSavedEntryAsync" FormName="CaloriesSavedEntryForm">
                            <DataAnnotationsValidator />
                            <div class="calories-compact-form calories-saved-entry-grid">
                                <div class="calories-compact-field calories-wide-field">
                                    <label class="form-label" for="calories-saved-food">Food</label>
                                    <InputSelect id="calories-saved-food" class="form-select" @bind-Value="savedEntryDraft.FoodId">
                                        <option value="">Choose a saved food</option>
                                        @foreach (var food in foods)
                                        {
                                            <option value="@food.Id">@food.Name — @food.CaloriesPerServing kcal/serving</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => savedEntryDraft.FoodId" />
                                    @if (foods.Count == 0)
                                    {
                                        <p class="form-text">Add foods in the Foods tab, or use a one-time custom entry.</p>
                                    }
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-serving-count">Serving multiplier</label>
                                    <InputNumber id="calories-serving-count" class="form-control" @bind-Value="savedEntryDraft.Servings" min="0.01" step="0.01" />
                                    <ValidationMessage For="() => savedEntryDraft.Servings" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-entry-time">Time eaten</label>
                                    <input id="calories-entry-time" class="form-control" type="time" value="@entryTime" @onchange="OnEntryTimeChanged" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-entry-notes">Note (optional)</label>
                                    <InputText id="calories-entry-notes" class="form-control" @bind-Value="entryNotes" maxlength="500" placeholder="Optional note" />
                                </div>
                                <div class="calories-form-submit">
                                    <button class="btn btn-primary" type="submit" disabled="@(isSavingEntry || foods.Count == 0)">
                                        @(isSavingEntry ? "Adding…" : "Add food")
                                    </button>
                                </div>
                            </div>
                            <p class="calories-compact-help">Nutrition is multiplied by this factor and rounded to whole numbers. Time uses device local time.</p>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm class="calories-entry-form" Model="customEntryDraft" OnValidSubmit="AddCustomEntryAsync" FormName="CaloriesCustomEntryForm">
                            <DataAnnotationsValidator />
                            <div class="calories-compact-form calories-custom-entry-grid">
                                <div class="calories-compact-field calories-wide-field">
                                    <label class="form-label" for="calories-custom-name">Food name</label>
                                    <InputText id="calories-custom-name" class="form-control" @bind-Value="customEntryDraft.Name" maxlength="160" />
                                    <ValidationMessage For="() => customEntryDraft.Name" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-custom-kcal">Calories (kcal)</label>
                                    <InputNumber id="calories-custom-kcal" class="form-control" @bind-Value="customEntryDraft.Calories" min="1" step="1" />
                                    <ValidationMessage For="() => customEntryDraft.Calories" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-custom-carbs">Carbohydrates (g)</label>
                                    <InputNumber id="calories-custom-carbs" class="form-control" @bind-Value="customEntryDraft.CarbohydratesGrams" min="0" step="1" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-custom-protein">Protein (g)</label>
                                    <InputNumber id="calories-custom-protein" class="form-control" @bind-Value="customEntryDraft.ProteinGrams" min="0" step="1" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-custom-fat">Fat (g)</label>
                                    <InputNumber id="calories-custom-fat" class="form-control" @bind-Value="customEntryDraft.FatGrams" min="0" step="1" />
                                </div>
                                <div class="calories-compact-field">
                                    <label class="form-label" for="calories-entry-time">Time eaten</label>
                                    <input id="calories-entry-time" class="form-control" type="time" value="@entryTime" @onchange="OnEntryTimeChanged" />
                                </div>
                                <div class="calories-compact-field calories-wide-field">
                                    <label class="form-label" for="calories-entry-notes">Note (optional)</label>
                                    <InputText id="calories-entry-notes" class="form-control" @bind-Value="entryNotes" maxlength="500" placeholder="Optional note" />
                                </div>
                                <div class="calories-form-submit">
                                    <button class="btn btn-primary" type="submit" disabled="@isSavingEntry">
                                        @(isSavingEntry ? "Adding…" : "Add custom food")
                                    </button>
                                </div>
                            </div>
                            <p class="calories-compact-help">Enter nutrition for the exact amount eaten. Time uses device local time.</p>
                        </EditForm>
                    }
                </section>
                }

                <section class="calories-panel calories-log-panel @(isTabletMode ? "calories-tablet-log-panel" : null)" aria-labelledby="daily-log-heading">
                    <div class="calories-panel-heading">
                        <div>
                            @if (!isTabletMode)
                            {
                                <p class="calories-eyebrow">Food recorded for this date</p>
                            }
                            <h2 id="daily-log-heading">Daily log</h2>
                        </div>
                        @if (isTabletMode)
                        {
                            <div class="calories-tablet-log-actions">
                                <span class="calories-item-count">@dayEntries.Count item(s)</span>
                                <button class="btn btn-primary btn-sm" type="button" @onclick="OpenTabletEntryForm">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                    Add food
                                </button>
                            </div>
                        }
                        else
                        {
                            <strong class="calories-log-total">@DailyCalories.ToString("N0", CultureInfo.CurrentCulture) kcal</strong>
                        }
                    </div>

                    @if (dayEntries.Count == 0)
                    {
                        <p class="calories-empty-state">Nothing logged yet. Add a saved or one-time food above.</p>
                    }
                    else
                    {
                        <div class="calories-log-list">
                            @foreach (var entry in dayEntries)
                            {
                                <article class="calories-log-item" @key="entry.Id">
                                    @if (editingEntryId == entry.Id)
                                    {
                                        <EditForm class="calories-entry-edit-form"
                                                  Model="entryEditDraft"
                                                  OnValidSubmit="SaveEntryEditAsync"
                                                  FormName="CaloriesEntryEditForm">
                                            <DataAnnotationsValidator />
                                            <div class="calories-compact-form calories-entry-edit-grid">
                                                <div class="calories-compact-field calories-wide-field">
                                                    <label class="form-label" for="@($"edit-entry-name-{entry.Id}")">Food name</label>
                                                    <InputText id="@($"edit-entry-name-{entry.Id}")" class="form-control" @bind-Value="entryEditDraft.Name" maxlength="160" />
                                                    <ValidationMessage For="() => entryEditDraft.Name" />
                                                </div>
                                                <div class="calories-compact-field">
                                                    <label class="form-label" for="@($"edit-entry-kcal-{entry.Id}")">Calories (kcal)</label>
                                                    <InputNumber id="@($"edit-entry-kcal-{entry.Id}")" class="form-control" @bind-Value="entryEditDraft.Calories" min="1" step="1" />
                                                    <ValidationMessage For="() => entryEditDraft.Calories" />
                                                </div>
                                                <div class="calories-compact-field">
                                                    <label class="form-label" for="@($"edit-entry-carbs-{entry.Id}")">Carbs (g)</label>
                                                    <InputNumber id="@($"edit-entry-carbs-{entry.Id}")" class="form-control" @bind-Value="entryEditDraft.CarbohydratesGrams" min="0" step="1" />
                                                </div>
                                                <div class="calories-compact-field">
                                                    <label class="form-label" for="@($"edit-entry-protein-{entry.Id}")">Protein (g)</label>
                                                    <InputNumber id="@($"edit-entry-protein-{entry.Id}")" class="form-control" @bind-Value="entryEditDraft.ProteinGrams" min="0" step="1" />
                                                </div>
                                                <div class="calories-compact-field">
                                                    <label class="form-label" for="@($"edit-entry-fat-{entry.Id}")">Fat (g)</label>
                                                    <InputNumber id="@($"edit-entry-fat-{entry.Id}")" class="form-control" @bind-Value="entryEditDraft.FatGrams" min="0" step="1" />
                                                </div>
                                                <div class="calories-compact-field">
                                                    @if (entryEditDraft.Servings is not null)
                                                    {
                                                        <label class="form-label" for="@($"edit-entry-servings-{entry.Id}")">Serving multiplier</label>
                                                        <InputNumber id="@($"edit-entry-servings-{entry.Id}")"
                                                                     class="form-control"
                                                                     @bind-Value="entryEditDraft.Servings"
                                                                     @bind-Value:after="ScaleEditedEntryForServingsChange"
                                                                     min="0.01"
                                                                     step="0.01" />
                                                        <ValidationMessage For="() => entryEditDraft.Servings" />
                                                    }
                                                </div>
                                                <div class="calories-compact-field">
                                                    <label class="form-label" for="@($"edit-entry-time-{entry.Id}")">Time eaten</label>
                                                    <input id="@($"edit-entry-time-{entry.Id}")"
                                                           class="form-control"
                                                           type="time"
                                                           value="@entryEditDraft.Time"
                                                           @onchange="OnEntryEditTimeChanged" />
                                                </div>
                                                <div class="calories-compact-field calories-wide-field">
                                                    <label class="form-label" for="@($"edit-entry-notes-{entry.Id}")">Note (optional)</label>
                                                    <InputText id="@($"edit-entry-notes-{entry.Id}")" class="form-control" @bind-Value="entryEditDraft.Notes" maxlength="500" />
                                                </div>
                                                <div class="calories-entry-edit-actions">
                                                    <button class="btn btn-primary btn-sm" type="submit" disabled="@isSavingEntryEdit">
                                                        @(isSavingEntryEdit ? "Saving…" : "Save")
                                                    </button>
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelEntryEdit">Cancel</button>
                                                </div>
                                            </div>
                                        </EditForm>
                                    }
                                    else
                                    {
                                        <time class="calories-log-time" datetime="@entry.LoggedAt.ToString("O", CultureInfo.InvariantCulture)">@entry.LoggedAt.ToString("HH:mm", CultureInfo.CurrentCulture)</time>
                                        <div class="calories-log-copy">
                                            <strong>@entry.Name</strong>
                                            @if (entry.Servings is decimal servings)
                                            {
                                                <span>@servings.ToString("0.##", CultureInfo.CurrentCulture) serving(s)</span>
                                            }
                                            <span>@FormatEntryMacros(entry)</span>
                                            @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                            {
                                                <span class="calories-log-note">@entry.Notes</span>
                                            }
                                        </div>
                                        <strong class="calories-log-kcal">@entry.Calories.ToString("N0", CultureInfo.CurrentCulture) kcal</strong>
                                        <div class="calories-log-actions">
                                            @if (entryPendingDeleteId == entry.Id)
                                            {
                                                <span class="calories-delete-confirmation">Delete this entry?</span>
                                                <button class="btn btn-danger btn-sm"
                                                        type="button"
                                                        disabled="@isDeletingEntry"
                                                        @onclick="() => RemoveLoggedEntryAsync(entry.Id)">
                                                    @(isDeletingEntry ? "Deleting…" : "Delete")
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm"
                                                        type="button"
                                                        disabled="@isDeletingEntry"
                                                        @onclick="CancelEntryDelete">
                                                    Keep
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary btn-sm"
                                                        type="button"
                                                        aria-label="@($"Edit {entry.Name}")"
                                                        @onclick="() => EditLoggedEntry(entry)">
                                                    Edit
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm"
                                                        type="button"
                                                        aria-label="@($"Delete {entry.Name}")"
                                                        @onclick="() => BeginEntryDelete(entry.Id)">
                                                    Delete
                                                </button>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>
            </section>
        }
        else if (activeTab == CaloriesTab.Foods)
        {
            <section id="calories-foods-panel" class="calories-tab-panel" role="tabpanel" aria-labelledby="calories-foods-tab" tabindex="0">
                <section class="calories-panel" aria-labelledby="calories-food-form-heading">
                    <div class="calories-panel-heading">
                        <div>
                            <p class="calories-eyebrow">Reusable items</p>
                            <h2 id="calories-food-form-heading">@(editingFoodId is null ? "Add a saved food" : "Edit saved food")</h2>
                        </div>
                        @if (editingFoodId is not null)
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelFoodEdit">Cancel edit</button>
                        }
                    </div>

                    <EditForm class="calories-food-form" Model="foodDraft" OnValidSubmit="SaveFoodAsync" FormName="CaloriesFoodForm">
                        <DataAnnotationsValidator />
                        <div class="calories-compact-form calories-food-entry-grid">
                            <div class="calories-compact-field calories-wide-field">
                                <label class="form-label" for="calories-food-name">Food name</label>
                                <InputText id="calories-food-name" class="form-control" @bind-Value="foodDraft.Name" maxlength="160" placeholder="e.g. Greek yogurt" />
                                <ValidationMessage For="() => foodDraft.Name" />
                            </div>
                            <div class="calories-compact-field">
                                <label class="form-label" for="calories-food-kcal">Calories per serving (kcal)</label>
                                <InputNumber id="calories-food-kcal" class="form-control" @bind-Value="foodDraft.CaloriesPerServing" min="1" step="1" />
                                <ValidationMessage For="() => foodDraft.CaloriesPerServing" />
                            </div>
                            <div class="calories-compact-field">
                                <label class="form-label" for="calories-food-carbs">Carbohydrates per serving (g)</label>
                                <InputNumber id="calories-food-carbs" class="form-control" @bind-Value="foodDraft.CarbohydratesGrams" min="0" step="1" />
                                <ValidationMessage For="() => foodDraft.CarbohydratesGrams" />
                            </div>
                            <div class="calories-compact-field">
                                <label class="form-label" for="calories-food-protein">Protein per serving (g)</label>
                                <InputNumber id="calories-food-protein" class="form-control" @bind-Value="foodDraft.ProteinGrams" min="0" step="1" />
                                <ValidationMessage For="() => foodDraft.ProteinGrams" />
                            </div>
                            <div class="calories-compact-field">
                                <label class="form-label" for="calories-food-fat">Fat per serving (g)</label>
                                <InputNumber id="calories-food-fat" class="form-control" @bind-Value="foodDraft.FatGrams" min="0" step="1" />
                                <ValidationMessage For="() => foodDraft.FatGrams" />
                            </div>
                            <div class="calories-form-submit">
                                <button class="btn btn-primary" type="submit" disabled="@isSavingFood">
                                    @(isSavingFood ? "Saving…" : editingFoodId is null ? "Save food" : "Save changes")
                                </button>
                            </div>
                        </div>
                        <p class="calories-compact-help">Nutrition is per serving; choose a multiplier up to two decimal places.</p>
                    </EditForm>
                </section>

                <section class="calories-panel" aria-labelledby="calories-saved-foods-heading">
                    <div class="calories-panel-heading">
                        <div>
                            <p class="calories-eyebrow">Available when logging</p>
                            <h2 id="calories-saved-foods-heading">Saved foods</h2>
                        </div>
                        <span class="calories-item-count">@foods.Count item(s)</span>
                    </div>
                    @if (foods.Count == 0)
                    {
                        <p class="calories-empty-state">No saved foods yet. Add a food above to use it again later.</p>
                    }
                    else
                    {
                        <div class="calories-food-list">
                            @foreach (var food in foods)
                            {
                                <article class="calories-food-item" @key="food.Id">
                                    <div class="calories-food-copy">
                                        <strong>@food.Name</strong>
                                        <span>@food.CaloriesPerServing.ToString("N0", CultureInfo.CurrentCulture) kcal per serving</span>
                                        <span>Carbs @FormatMacro(food.CarbohydratesGrams) · Protein @FormatMacro(food.ProteinGrams) · Fat @FormatMacro(food.FatGrams)</span>
                                    </div>
                                    <div class="calories-food-actions">
                                        @if (foodPendingDeleteId == food.Id)
                                        {
                                            <span class="calories-delete-confirmation">Delete this saved food?</span>
                                            <button class="btn btn-danger btn-sm" type="button" @onclick="() => RemoveFoodAsync(food.Id)">Delete</button>
                                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CancelFoodDelete">Keep</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => EditFood(food)">Edit</button>
                                            <button class="btn btn-outline-danger btn-sm" type="button" @onclick="() => BeginFoodDelete(food.Id)">Delete</button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            </section>
        }
        else
        {
            <section id="calories-statistics-panel" class="calories-tab-panel" role="tabpanel" aria-labelledby="calories-statistics-tab" tabindex="0">
                <section class="calories-panel" aria-labelledby="calories-history-heading">
                    <div class="calories-panel-heading">
                        <div>
                            <p class="calories-eyebrow">Calories only · all logged foods</p>
                            <h2 id="calories-history-heading">History</h2>
                        </div>
                        <div class="calories-history-total">
                            <strong>@HistoryTotal.ToString("N0", CultureInfo.CurrentCulture)</strong>
                            <span>kcal in range</span>
                        </div>
                    </div>

                    <div class="calories-history-period" role="group" aria-label="History period">
                        <button class="calories-entry-mode-button @(historyPeriod == HistoryPeriod.Daily ? "active" : null)" type="button" aria-pressed="@(historyPeriod == HistoryPeriod.Daily)" @onclick="() => ChangeHistoryPeriodAsync(HistoryPeriod.Daily)">Daily</button>
                        <button class="calories-entry-mode-button @(historyPeriod == HistoryPeriod.Weekly ? "active" : null)" type="button" aria-pressed="@(historyPeriod == HistoryPeriod.Weekly)" @onclick="() => ChangeHistoryPeriodAsync(HistoryPeriod.Weekly)">Weekly</button>
                        <button class="calories-entry-mode-button @(historyPeriod == HistoryPeriod.Monthly ? "active" : null)" type="button" aria-pressed="@(historyPeriod == HistoryPeriod.Monthly)" @onclick="() => ChangeHistoryPeriodAsync(HistoryPeriod.Monthly)">Monthly</button>
                    </div>

                    @if (isLoadingHistory)
                    {
                        <p class="calories-empty-state" role="status">Loading history…</p>
                    }
                    else if (historyError is not null)
                    {
                        <div class="alert alert-danger" role="alert">@historyError</div>
                    }
                    else
                    {
                        <p class="calories-history-range">@HistoryRangeText</p>
                        <div class="calories-history-chart-scroll" tabindex="0" aria-label="Scrollable calorie history chart">
                            <div class="calories-history-chart" role="group" aria-label="@ChartAccessibleLabel">
                                <strong class="calories-chart-axis-heading">kcal</strong>
                                <div class="calories-chart-axis-labels" aria-hidden="true">
                                    @for (var tickIndex = 4; tickIndex >= 0; tickIndex--)
                                    {
                                        <span>@GetChartTickValue(tickIndex).ToString("N0", CultureInfo.CurrentCulture)</span>
                                    }
                                </div>
                                <div class="calories-chart-columns" style="--calories-chart-columns: @historyPoints.Count; --calories-chart-column-width: @(ChartColumnWidth)px">
                                    @for (var index = 0; index < historyPoints.Count; index++)
                                    {
                                        var pointIndex = index;
                                        var point = historyPoints[index];
                                        var isSelected = selectedChartPointIndex == pointIndex;
                                        <button class="calories-chart-column @(isSelected ? "selected" : null)"
                                                type="button"
                                                aria-pressed="@isSelected"
                                                aria-label="@($"{point.Label}: {point.Calories:N0} kilocalories")"
                                                title="@($"{point.Label}: {point.Calories:N0} kcal")"
                                                @onclick="() => SelectChartPoint(pointIndex)">
                                            <span class="calories-chart-bar-space">
                                                <span class="calories-chart-bar" style="height: @(GetBarHeightPercent(point.Calories))%"></span>
                                            </span>
                                            <span class="calories-chart-label">@point.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (SelectedChartPoint is { } selectedPoint)
                        {
                            <div class="calories-chart-selection" role="status" aria-live="polite">
                                <strong>@selectedPoint.Label</strong>
                                <strong>@selectedPoint.Calories.ToString("N0", CultureInfo.CurrentCulture) kcal</strong>
                            </div>
                        }
                        else
                        {
                            <p class="calories-chart-selection-hint">Tap or click a column to see its calorie total.</p>
                        }
                        <div class="calories-history-average">
                            <span>Average per @HistoryPeriodLabel.ToLowerInvariant()</span>
                            <strong>@HistoryAverage.ToString("N0", CultureInfo.CurrentCulture) kcal</strong>
                        </div>
                        <div class="calories-history-table-wrap">
                            <table class="calories-history-table">
                                <thead>
                                    <tr>
                                        <th scope="col">@HistoryPeriodLabel</th>
                                        <th scope="col">Total calories</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in historyPoints.AsEnumerable().Reverse())
                                    {
                                        <tr @key="point.Start">
                                            <th scope="row">@point.Label</th>
                                            <td>@point.Calories.ToString("N0", CultureInfo.CurrentCulture) kcal</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </section>
        }
    }
</div>
