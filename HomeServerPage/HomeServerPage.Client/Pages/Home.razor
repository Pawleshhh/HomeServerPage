@page "/"
@attribute [StreamRendering]
@using HomeServerPage.Client.Pages.Astronomy
@using HomeServerPage.Client.Pages.Fridge
@using HomeServerPage.Client.Pages.PublicTransport
@using HomeServerPage.Client.Pages.Weather

<PageTitle>Home</PageTitle>

<div class="container-fluid dashboard-page">
    <PageHeader Title="Home Base"
                Description="A calm overview of the things you use every day."
                Accent="home" />

    <section class="dashboard-grid" aria-label="Daily essentials">
        <div class="dashboard-grid-item dashboard-grid-item-fridge">
            <ExpiringFridgeItems />
        </div>
        <div class="dashboard-grid-item dashboard-grid-item-transport">
            <PublicTransportWidget />
        </div>
        <div class="dashboard-grid-item dashboard-grid-item-weather">
            <WeatherWidget />
        </div>
        <div class="dashboard-grid-item dashboard-grid-item-astronomy">
            <AstronomyWidget />
        </div>
    </section>
</div>
