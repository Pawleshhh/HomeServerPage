@page "/fridge"
@attribute [StreamRendering]
@using HomeServerPage.Data.Fridge
@using HomeServerPage.Shared.Extensions
@inject IFridgeService FridgeService
@inject HomeServerPage.Data.IDateTimeService DateTimeService

<PageTitle>My Fridge</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <PageHeader Title="My Fridge"
                        Description="Keep track of what is in the fridge and what needs using next."
                        Accent="fridge" />

            <section class="feature-panel fridge-form-panel" aria-labelledby="fridge-form-heading">
                <div class="feature-panel-heading">
                    <div>
                        <h2 id="fridge-form-heading">@(SelectedItemId is null ? "Add an item" : "Edit item")</h2>
                        <p>@(SelectedItemId is null ? "Record something before it gets forgotten in the back of the fridge." : "Update the selected item, then save the changes.")</p>
                    </div>
                    @if (SelectedItemId is not null)
                    {
                        <span class="editing-badge">Editing selected item</span>
                    }
                </div>

                <EditForm class="fridge-form" Model="@EditedFridgeItem" OnValidSubmit="OnValidFridgeItemSubmitAsync" FormName="FridgeAddForm" method="post">
                    <DataAnnotationsValidator/>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label label-truncate" for="fridge-name">Name</label>
                        <InputText id="fridge-name" class="form-control" @bind-Value="@EditedFridgeItem.Name" placeholder="Milk" />
                        <ValidationMessage For="@(() => @EditedFridgeItem.Name)" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-quantity">Quantity @FridgeLabels.GetQuantityTypeLabel(EditedFridgeItem.QuantityType)</label>
                        <InputNumber id="fridge-quantity" class="form-control" @bind-Value="@EditedFridgeItem.QuanitityValue" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-quantity-type">Quantity type</label>
                        <InputSelect id="fridge-quantity-type" class="form-select" @bind-Value="@EditedFridgeItem.QuantityType">
                            @foreach (var quantityType in QuantityTypes)
                            {
                                <option value="@quantityType">@quantityType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-added-date">Added Date</label>
                        <InputDate id="fridge-added-date" class="form-control" @bind-Value="@EditedFridgeItem.AddedDate" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-expiration-date">Expiration Date</label>
                        <InputDate id="fridge-expiration-date" class="form-control" @bind-Value="@EditedFridgeItem.ExpirationDate" />
                        <ValidationMessage For="@(() => @EditedFridgeItem.ExpirationDate)" />
                    </div>


                    <div class="col-12 col-md-3">
                        <label class="form-label label-truncate" for="fridge-open-date">Open Date</label>
                        <InputDate id="fridge-open-date" class="form-control" @bind-Value="@EditedFridgeItem.OpenDate" />
                        <ValidationMessage For="@(() => @EditedFridgeItem.OpenDate)" />
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label label-truncate" for="fridge-time-after-open">Time after open</label>
                        <InputNumber id="fridge-time-after-open" class="form-control" @bind-Value="@TimeAfterOpenDisplayValue" />
                    </div>

                    <div class="col-12 col-md-1">
                        <label class="form-label label-truncate" for="fridge-time-after-open-unit">Unit</label>
                        <InputSelect id="fridge-time-after-open-unit" class="form-select" @bind-Value="@SelectedTimeAfterOpenUnit">
                            @foreach (var unit in Enum.GetValues<TimeAfterOpenUnit>())
                            {
                                <option value="@unit">@unit</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12 fridge-form-actions">
                        @if (SelectedItemId is not null)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="ClearSelection">Cancel</button>
                        }
                        <button type="submit" class="btn btn-primary">@(SelectedItemId is not null ? "Save Changes" : "Add to Fridge")</button>
                    </div>
                </div>
                </EditForm>
            </section>

            <div class="feature-section-heading">
                <div>
                    <h2>Fridge items</h2>
                    <p>Current products stored in the fridge.</p>
                </div>
                <span class="badge item-count-badge">@SortedItems.Count item(s)</span>
            </div>

            @if (Items.Count == 0)
            {
                <div class="alert alert-light border mb-0" role="status">
                    No fridge items yet. Add your first product using the form above.
                </div>
            }
            else
            {
                <div class="fridge-desktop-table table-responsive">
                    <table class="table table-hover align-middle mb-0 fridge-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col" class="d-none d-sm-table-cell">Qty</th>
                                <th scope="col" class="d-none d-lg-table-cell">Type</th>
                                <th scope="col" class="d-none d-md-table-cell sortable-header">
                                    <button type="button" class="table-sort-button" @onclick="() => SortBy(FridgeSortColumn.Added)">Added @GetSortIcon(FridgeSortColumn.Added)</button>
                                </th>
                                <th scope="col" class="d-none d-xl-table-cell sortable-header">
                                    <button type="button" class="table-sort-button" @onclick="() => SortBy(FridgeSortColumn.Opened)">Opened @GetSortIcon(FridgeSortColumn.Opened)</button>
                                </th>
                                <th scope="col" class="sortable-header">
                                    <button type="button" class="table-sort-button" @onclick="() => SortBy(FridgeSortColumn.Expires)">Expires @GetSortIcon(FridgeSortColumn.Expires)</button>
                                </th>
                                <th scope="col" class="sortable-header">
                                    <button type="button" class="table-sort-button" @onclick="() => SortBy(FridgeSortColumn.DaysLeft)">Days Left @GetSortIcon(FridgeSortColumn.DaysLeft)</button>
                                </th>
                                <th scope="col" class="d-none d-xl-table-cell">Time (hrs)</th>
                                <th scope="col" aria-label="Buttons"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in SortedItems)
                            {
                                <tr class="fridge-table-row @(item.Id == SelectedItemId ? "table-active" : null)" tabindex="0" aria-selected="@(item.Id == SelectedItemId)" @onclick="() => SelectItem(item)" @onkeydown="(args) => SelectItemOnKeyDown(args, item)">
                                    <td class="fw-semibold">
                                        <div>@item.Name</div>
                                        <small class="text-muted d-sm-none">@item.QuantityValue @item.QuantityType</small>
                                    </td>
                                    <td class="d-none d-sm-table-cell">@item.QuantityValue</td>
                                    <td class="d-none d-lg-table-cell">@item.QuantityType @FridgeLabels.GetQuantityTypeLabel(item.QuantityType)</td>
                                    <td class="d-none d-md-table-cell">@item.AddedDate.ToString("d")</td>
                                    <td class="d-none d-xl-table-cell">@(item.OpenDate.HasValue ? item.OpenDate.Value.ToString("d") : "-")</td>
                                    <td>@item.ExpirationDate.ToString("d")</td>
                                    <td>
                                        <span class="badge @FridgeLabels.GetDaysLeftBadgeClass(item, DateTimeService.Now)">@FridgeLabels.GetDaysLeftText(item, DateTimeService.Now)</span>
                                    </td>
                                    <td class="d-none d-xl-table-cell">@(item.TimeAfterOpen.Value()?.TotalHours)</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary fridge-action-button" @onclick="() => CopyItemAsync(item)" @onclick:stopPropagation="true" aria-label="Copy @item.Name" title="Copy">
                                            <span aria-hidden="true">Copy</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger fridge-action-button" @onclick="() => RemoveItemAsync(item)" @onclick:stopPropagation="true" aria-label="Remove @item.Name" title="Remove">
                                            <span aria-hidden="true">Remove</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="fridge-mobile-list" aria-label="Fridge items">
                    @foreach (var item in SortedItems)
                    {
                        <article class="fridge-mobile-item @(item.Id == SelectedItemId ? "is-selected" : null)">
                            <button type="button" class="fridge-mobile-select" @onclick="() => SelectItem(item)" aria-pressed="@(item.Id == SelectedItemId)" aria-label="Select @item.Name for editing">
                                <span class="fridge-mobile-name">@item.Name</span>
                                <span class="fridge-mobile-quantity">@item.QuantityValue @item.QuantityType</span>
                            </button>
                            <div class="fridge-mobile-details">
                                <div>
                                    <span class="fridge-mobile-label">Expires</span>
                                    <span>@item.ExpirationDate.ToString("d")</span>
                                </div>
                                <div>
                                    <span class="fridge-mobile-label">Status</span>
                                    <span class="badge @FridgeLabels.GetDaysLeftBadgeClass(item, DateTimeService.Now)">@FridgeLabels.GetDaysLeftText(item, DateTimeService.Now)</span>
                                </div>
                            </div>
                            <div class="fridge-mobile-actions">
                                <button type="button" class="btn btn-sm btn-outline-primary fridge-action-button" @onclick="() => CopyItemAsync(item)" aria-label="Copy @item.Name">
                                    Copy
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger fridge-action-button" @onclick="() => RemoveItemAsync(item)" aria-label="Remove @item.Name">
                                    Remove
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {

    public FridgeItemModel EditedFridgeItem { get; set; } = FridgeItemModel.CreateClearEditedFridgeItem(DateTime.Now);
    public List<FridgeItem> Items { get; set; } = [];
    public int? SelectedItemId { get; set; }

    private static IReadOnlyList<QuantityType> QuantityTypes { get; } = Enum.GetValues<QuantityType>();

    private enum TimeAfterOpenUnit
    {
        Hours,
        Days
    }

    private TimeAfterOpenUnit SelectedTimeAfterOpenUnit { get; set; } = TimeAfterOpenUnit.Hours;

    private int? TimeAfterOpenDisplayValue
    {
        get
        {
            if (EditedFridgeItem.TimeAfterOpen is null)
            {
                return null;
            }

            return SelectedTimeAfterOpenUnit switch
            {
                TimeAfterOpenUnit.Days => EditedFridgeItem.TimeAfterOpen.Value / 24,
                _ => EditedFridgeItem.TimeAfterOpen
            };
        }
        set
        {
            EditedFridgeItem.TimeAfterOpen = value is null
                ? null
                : SelectedTimeAfterOpenUnit switch
                {
                    TimeAfterOpenUnit.Days => value.Value * 24,
                    _ => value.Value
                };
        }
    }

    private enum FridgeSortColumn
    {
        Added,
        Opened,
        Expires,
        DaysLeft
    }

    private FridgeSortColumn CurrentSortColumn { get; set; } = FridgeSortColumn.DaysLeft;

    private bool SortAscending { get; set; } = true;

    private List<FridgeItem> SortedItems
    {
        get
        {
            IOrderedEnumerable<FridgeItem> ordered = CurrentSortColumn switch
            {
                FridgeSortColumn.Added => SortAscending
                    ? Items.OrderBy(i => i.AddedDate)
                    : Items.OrderByDescending(i => i.AddedDate),
                FridgeSortColumn.Opened => SortAscending
                    ? Items.OrderBy(i => i.OpenDate)
                    : Items.OrderByDescending(i => i.OpenDate),
                FridgeSortColumn.Expires => SortAscending
                    ? Items.OrderBy(i => i.ExpirationDate)
                    : Items.OrderByDescending(i => i.ExpirationDate),
                FridgeSortColumn.DaysLeft => SortAscending
                    ? Items.OrderBy(FridgeLabels.GetEffectiveExpirationDate)
                    : Items.OrderByDescending(FridgeLabels.GetEffectiveExpirationDate),
                _ => Items.OrderBy(i => i.Id)
            };

            return ordered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await DateTimeService.SyncAsync();
        EditedFridgeItem = FridgeItemModel.CreateClearEditedFridgeItem(DateTimeService.Now);
        Items = await FridgeService.GetItemsAsync();
        await base.OnInitializedAsync();
    }

    private async Task OnValidFridgeItemSubmitAsync(EditContext args)
    {
        if (SelectedItemId is int selectedId)
        {
            await FridgeService.UpdateItemAsync(this.EditedFridgeItem.ToFridgeItem() with { Id = selectedId });
        }
        else
        {
            await FridgeService.AddItemAsync(this.EditedFridgeItem.ToFridgeItem());
        }

        ClearSelection();
        Items = await FridgeService.GetItemsAsync();
    }

    private void ClearSelection()
    {
        SelectedItemId = null;
        EditedFridgeItem = FridgeItemModel.CreateClearEditedFridgeItem(DateTimeService.Now);
    }

    private void SelectItem(FridgeItem item)
    {
        if (SelectedItemId == item.Id)
        {
            ClearSelection();
            return;
        }

        SelectedItemId = item.Id;
        EditedFridgeItem = FridgeItemModel.FromFridgeItem(item);
    }

    private void SelectItemOnKeyDown(KeyboardEventArgs args, FridgeItem item)
    {
        if (args.Key is "Enter" or " ")
        {
            SelectItem(item);
        }
    }

    private void SortBy(FridgeSortColumn column)
    {
        if (CurrentSortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            CurrentSortColumn = column;
            SortAscending = true;
        }
    }

    private string GetSortIcon(FridgeSortColumn column)
    {
        if (CurrentSortColumn != column)
        {
            return string.Empty;
        }

        return SortAscending ? "\u25b2" : "\u25bc";
    }

    private async Task CopyItemAsync(FridgeItem item)
    {
        var cloned = item with { Id = 0, AddedDate = DateTimeService.Now.Date };
        var created = await FridgeService.AddItemAsync(cloned);

        Items = await FridgeService.GetItemsAsync();
        SelectItem(created);
    }

    private async Task RemoveItemAsync(FridgeItem item)
    {
        await FridgeService.RemoveItemAsync(item.Id);
        Items = await FridgeService.GetItemsAsync();
    }

}
