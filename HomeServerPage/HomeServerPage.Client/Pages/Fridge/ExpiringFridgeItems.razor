@using HomeServerPage.Data.Fridge
@using HomeServerPage.Data.Calories
@using HomeServerPage.Data.Notifications
@implements IDisposable
@inject IFridgeService FridgeService
@inject ICaloriesService CaloriesService
@inject HomeServerPage.Data.IDateTimeService DateTimeService
@inject HomeServerPage.Client.Data.TabletDashboardRefreshService DashboardRefreshService
@inject IJSRuntime JS
@inject ILogger<ExpiringFridgeItems> Logger

<script type="module" src="@Assets["Pages/Calories/Calories.razor.js"]"></script>

<section class="dashboard-card dashboard-card-fridge card h-100 @(CompactTablet ? "fridge-widget-compact-tablet" : null)" aria-labelledby="expiring-fridge-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <DashboardCardRefreshIcon IconClass="bi-snow2"
                                          RefreshLabel="Refresh fridge and calories"
                                          RefreshEnabled="@AutoRefresh"
                                          IsLoading="@(this.isRefreshing || this.isLoadingItems)"
                                          OnRefresh="this.HandleRefreshRequestedAsync" />
                <div>
                    <h2 id="expiring-fridge-heading" class="dashboard-card-title">Expiring soon</h2>
                    <p class="dashboard-card-subtitle">Keep an eye on these fridge items.</p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary dashboard-card-action" href="@DetailsHref">Open fridge</a>
        </div>

        @if (this.errorMessage is not null)
        {
            <p class="dashboard-card-status is-error mb-0" role="alert">@this.errorMessage</p>
        }
        else if (this.Items is null)
        {
            <p class="dashboard-card-status" role="status">Loading fridge items…</p>
        }
        else if (this.Items.Count == 0)
        {
            <p class="dashboard-card-status is-empty mb-0">No fridge items yet.</p>
        }
        else
        {
            <div class="list-group list-group-flush fridge-expiring-list">
                @foreach (var item in this.Items)
                {
                    <div class="list-group-item fridge-expiring-item">
                        <div class="fridge-item-details">
                            <div class="fridge-item-name">@item.Name</div>
                            <small class="fridge-item-meta">@item.QuantityValue @item.QuantityType · Expires @FridgeLabels.GetEffectiveExpirationDate(item).ToString("d")</small>
                        </div>
                        <span class="badge rounded-pill @FridgeLabels.GetDaysLeftBadgeClass(item, DateTimeService.Now) flex-shrink-0">@FridgeLabels.GetDaysLeftText(item, DateTimeService.Now)</span>
                    </div>
                }
            </div>
        }

        <div class="fridge-calories-progress" aria-label="Calories consumed today">
            <span class="fridge-calories-progress-label">Calories today</span>
            @if (caloriesGoal is int goal && caloriesError is null && !isLoadingCalories)
            {
                <div class="fridge-calories-progress-track"
                     role="progressbar"
                     aria-label="Calories consumed today"
                     aria-valuemin="0"
                     aria-valuemax="@goal"
                     aria-valuenow="@Math.Min(caloriesConsumed, goal)"
                     aria-valuetext="@($"{caloriesConsumed:N0} of {goal:N0} kcal")">
                    <span style="width: @(CaloriesProgressPercent)%"></span>
                </div>
            }
            else
            {
                <div class="fridge-calories-progress-track" aria-hidden="true">
                    <span></span>
                </div>
            }
            <span class="fridge-calories-progress-value"
                  aria-live="polite"
                  title="@(caloriesGoal is null ? "Set a daily goal in Calories to track progress." : null)">
                @CaloriesTodayValue
            </span>
        </div>
    </div>
</section>
