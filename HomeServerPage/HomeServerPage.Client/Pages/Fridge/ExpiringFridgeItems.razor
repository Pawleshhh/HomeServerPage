@using HomeServerPage.Data.Fridge
@inject IFridgeService FridgeService
@inject HomeServerPage.Data.IDateTimeService DateTimeService

<section class="dashboard-card dashboard-card-fridge card h-100" aria-labelledby="expiring-fridge-heading">
    <div class="card-body">
        <div class="dashboard-card-header">
            <div class="dashboard-card-heading">
                <span class="dashboard-card-icon" aria-hidden="true">🧊</span>
                <div>
                    <h2 id="expiring-fridge-heading" class="dashboard-card-title">Expiring soon</h2>
                    <p class="dashboard-card-subtitle">Keep an eye on these fridge items.</p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary dashboard-card-action" href="/fridge">Open fridge</a>
        </div>

        @if (Items is null)
        {
            <p class="dashboard-card-status" role="status">Loading fridge items…</p>
        }
        else if (Items.Count == 0)
        {
            <p class="dashboard-card-status is-empty mb-0">No fridge items yet.</p>
        }
        else
        {
            <div class="list-group list-group-flush fridge-expiring-list">
                @foreach (var item in Items)
                {
                    <div class="list-group-item fridge-expiring-item">
                        <div class="fridge-item-details">
                            <div class="fridge-item-name">@item.Name</div>
                            <small class="fridge-item-meta">@item.QuantityValue @item.QuantityType · Expires @FridgeLabels.GetEffectiveExpirationDate(item).ToString("d")</small>
                        </div>
                        <span class="badge rounded-pill @FridgeLabels.GetDaysLeftBadgeClass(item, DateTimeService.Now) flex-shrink-0">@FridgeLabels.GetDaysLeftText(item, DateTimeService.Now)</span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<FridgeItem>? Items;

    protected override async Task OnInitializedAsync()
    {
        await DateTimeService.SyncAsync();
        var items = await FridgeService.GetItemsAsync();
        Items = items
            .OrderBy(FridgeLabels.GetEffectiveExpirationDate)
            .Take(3)
            .ToList();
    }
}
