@using HomeServerPage.Data.Fridge
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Diagnostics.CodeAnalysis
@inherits InputBase<string>

<div class="fridge-template-autocomplete">
    <input id="@Id"
           class="form-control @CssClass"
           value="@CurrentValueAsString"
           autocomplete="off"
           role="combobox"
           aria-autocomplete="list"
           aria-controls="@SuggestionsId"
           aria-expanded="@(IsSuggestionsVisible && Suggestions.Count > 0)"
           aria-activedescendant="@ActiveSuggestionId"
           @oninput="HandleInput"
           @onfocus="HandleFocus"
           @onkeydown="HandleKeyDown" />

    @if (IsSuggestionsVisible && Suggestions.Count > 0)
    {
        <ul id="@SuggestionsId" class="fridge-template-suggestions" role="listbox">
            @for (var index = 0; index < Suggestions.Count; index++)
            {
                var suggestion = Suggestions[index];
                var suggestionId = GetSuggestionId(index);
                <li id="@suggestionId" class="fridge-template-suggestion" role="option" aria-selected="@(index == ActiveSuggestionIndex)" @key="suggestion.Id">
                    <button type="button"
                            class="fridge-template-suggestion-button @(index == ActiveSuggestionIndex ? "is-active" : null)"
                            @onmousedown:preventDefault="true"
                            @onclick="() => SelectTemplateAsync(suggestion)">
                        @suggestion.Name
                    </button>
                </li>
            }
        </ul>
    }
</div>
