@page "/tablet-dashboard"
@layout TabletLayout
@implements IAsyncDisposable
@using HomeServerPage.Client.Pages.Astronomy
@using HomeServerPage.Client.Pages.Fridge
@using HomeServerPage.Client.Pages.PublicTransport
@using HomeServerPage.Client.Pages.Weather
@inject HomeServerPage.Client.Data.TabletDashboardRefreshService DashboardRefreshService

<PageTitle>Tablet Dashboard</PageTitle>

<div class="tablet-dashboard">
    <section class="tablet-dashboard-grid" aria-label="Daily essentials">
        <div class="tablet-dashboard-item tablet-dashboard-item-fridge">
            <ExpiringFridgeItems DetailsHref="/tablet-dashboard/fridge" AutoRefresh="true" CompactTablet="true" />
        </div>
        <div class="tablet-dashboard-item tablet-dashboard-item-transport">
            <PublicTransportWidget DetailsHref="/tablet-dashboard/public-transport" CompactTablet="true" AutoRefresh="true" />
        </div>
        <div class="tablet-dashboard-item tablet-dashboard-item-weather">
            <WeatherWidget AutoRefresh="true" />
        </div>
        <div class="tablet-dashboard-item tablet-dashboard-item-astronomy">
            <AstronomyWidget DetailsHref="/tablet-dashboard/astronomy" CompactTablet="true" AutoRefresh="true" />
        </div>
    </section>
</div>
