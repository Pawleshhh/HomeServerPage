@page "/tablet-dashboard/fridge"
@layout TabletLayout
@using HomeServerPage.Data.Fridge
@inject IFridgeService FridgeService
@inject HomeServerPage.Data.IDateTimeService DateTimeService

<PageTitle>Tablet Fridge</PageTitle>

<section class="tablet-page tablet-fridge" aria-labelledby="tablet-fridge-heading">
    <header class="tablet-page-header">
        <div>
            <h1 id="tablet-fridge-heading">Fridge</h1>
            <p>@items.Count item(s), ordered by expiration.</p>
        </div>
        <button type="button" class="btn btn-outline-primary" @onclick="LoadItemsAsync" disabled="@isLoading">@(isLoading ? "Refreshing..." : "Refresh")</button>
    </header>

    @if (isLoading && items.Count == 0)
    {
        <p class="tablet-page-status" role="status">Loading fridge items…</p>
    }
    else if (errorMessage is not null)
    {
        <p class="tablet-page-status is-error" role="alert">@errorMessage</p>
    }
    else if (items.Count == 0)
    {
        <p class="tablet-page-status" role="status">No fridge items yet.</p>
    }
    else
    {
        <div class="tablet-fridge-list" aria-label="Fridge items">
            @foreach (var item in items)
            {
                <article class="tablet-fridge-item">
                    <div class="tablet-fridge-item-copy">
                        <h2>@item.Name</h2>
                        <p>@item.QuantityValue @item.QuantityType · Expires @FridgeLabels.GetEffectiveExpirationDate(item).ToString("d")</p>
                    </div>
                    <span class="badge @FridgeLabels.GetDaysLeftBadgeClass(item, DateTimeService.Now)">@FridgeLabels.GetDaysLeftText(item, DateTimeService.Now)</span>
                    <div class="tablet-fridge-actions" role="group" aria-label="Actions for @item.Name">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => ChangeQuantityAsync(item, -GetQuantityStep(item))" disabled="@(item.QuantityValue <= 0)" aria-label="Decrease quantity of @item.Name">−</button>
                        <span class="tablet-fridge-quantity">@item.QuantityValue</span>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => ChangeQuantityAsync(item, GetQuantityStep(item))" aria-label="Increase quantity of @item.Name">+</button>
                        @if (!item.OpenDate.HasValue)
                        {
                            <button type="button" class="btn btn-outline-success" @onclick="() => OpenItemAsync(item)">Open</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private List<FridgeItem> items = [];
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            items = (await FridgeService.GetItemsAsync())
                .OrderBy(FridgeLabels.GetEffectiveExpirationDate)
                .ToList();
        }
        catch (Exception)
        {
            errorMessage = "Could not load fridge items.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeQuantityAsync(FridgeItem item, double adjustment)
    {
        var quantity = Math.Round(Math.Max(0, item.QuantityValue + adjustment), 2);
        if (quantity == item.QuantityValue)
        {
            return;
        }

        await FridgeService.UpdateItemAsync(item with { QuantityValue = quantity });
        await LoadItemsAsync();
    }

    private async Task OpenItemAsync(FridgeItem item)
    {
        await FridgeService.UpdateItemAsync(item with { OpenDate = DateTimeService.Now.Date });
        await LoadItemsAsync();
    }

    private static double GetQuantityStep(FridgeItem item) => item.QuantityType == QuantityType.Weight ? 0.1 : 1;
}
