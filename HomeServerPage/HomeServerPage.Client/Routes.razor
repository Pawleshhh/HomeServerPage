@inject NavigationManager NavigationManager

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="CurrentLayout" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private Type CurrentLayout => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("tablet-dashboard/", StringComparison.OrdinalIgnoreCase)
        ? typeof(Layout.TabletLayout)
        : typeof(Layout.MainLayout);
}
