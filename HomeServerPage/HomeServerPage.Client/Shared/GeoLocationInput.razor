@using AstroCalc.Core

<div class="geo-location-input">
    <div class="row g-2">
        <div class="@(ShowElevation ? "col-4" : "col-6")">
            <label class="form-label" for="@_latitudeId">Latitude</label>
            <input id="@_latitudeId"
                   type="number"
                   class="form-control form-control-sm"
                   step="0.000001"
                   min="-90"
                   max="90"
                   value="@Value.Latitude.Degrees"
                   @onchange="OnLatitudeChanged" />
        </div>

        <div class="@(ShowElevation ? "col-4" : "col-6")">
            <label class="form-label" for="@_longitudeId">Longitude</label>
            <input id="@_longitudeId"
                   type="number"
                   class="form-control form-control-sm"
                   step="0.000001"
                   min="-180"
                   max="180"
                   value="@Value.Longitude.Degrees"
                   @onchange="OnLongitudeChanged" />
        </div>

        @if (ShowElevation)
        {
            <div class="col-4">
                <label class="form-label" for="@_elevationId">Elevation (m)</label>
                <input id="@_elevationId"
                       type="number"
                       class="form-control form-control-sm"
                       step="1"
                       value="@Value.ElevationMeters"
                       @onchange="OnElevationChanged" />
            </div>
        }
    </div>
</div>
