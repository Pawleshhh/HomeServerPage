@if (IsVisible)
{
    <div class="confirmation-dialog-backdrop" @onclick="HandleCancelAsync" @onkeydown="HandleKeyDownAsync">
        <section class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="@TitleId" aria-describedby="@(HasMessage ? DescriptionId : null)" tabindex="-1" @onclick:stopPropagation="true">
            <div class="confirmation-dialog-heading">
                @if (!string.IsNullOrWhiteSpace(Icon))
                {
                    <span class="confirmation-dialog-icon" aria-hidden="true">@Icon</span>
                }
                <div>
                    <h2 id="@TitleId">@Title</h2>
                    @if (HasMessage)
                    {
                        <div id="@DescriptionId" class="confirmation-dialog-message">
                            @if (ChildContent is not null)
                            {
                                @ChildContent
                            }
                            else
                            {
                                <p>@Message</p>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="confirmation-dialog-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancelAsync" autofocus>@CancelText</button>
                <button type="button" class="btn @ConfirmButtonClass" @onclick="HandleConfirmAsync">@ConfirmText</button>
            </div>
        </section>
    </div>
}
