<section class="page-header page-header-@Accent" aria-labelledby="@HeadingId">
    <div class="page-header-marker" aria-hidden="true"></div>
    <div class="page-header-copy">
        <h1 id="@HeadingId">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">
            @Actions
        </div>
    }
</section>
